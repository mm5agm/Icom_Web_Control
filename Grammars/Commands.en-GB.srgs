<?xml version="1.0" encoding="UTF-8"?>
<!--
  Icom Web Control voice command grammar — en-GB (v1).

  Six intents (matches docs/VoiceControl/v1-plan.md):

    SetFrequency   "set frequency to 14 point 0 7 4 megahertz"
    SetBand        "go to 20 metres"
    SetMode        "set mode U S B"
    SwapVFO        "swap V F O"
    NudgeFrequency "tune up" / "tune down" / "step up" / "step down"

  Numbers:
    - Whole MHz spoken as a single word (fourteen, twenty-eight, fifty).
      Range covers HF amateur bands + 6m and 4m (1-75 MHz).
    - Fractional MHz spoken digit-by-digit after "point" -- "fourteen
      point zero seven four" -> 14.074 MHz. Three-digit fractional gets
      kHz resolution which is fine for v1.

  Mode letters spelled phonetically ("U S B" not "USB") -- SAPI struggles
  with acronyms in grammar mode.

  Scots variants ("tae" for "to") interspersed where the construction
  changes -- Colin (MM5AGM) operates in Scots English.
-->
<grammar version="1.0"
         xml:lang="en-GB"
         tag-format="semantics/1.0"
         xmlns="http://www.w3.org/2001/06/grammar"
         root="command">

  <rule id="command" scope="public">
    <one-of>
      <item><ruleref uri="#setFrequency"/></item>
      <item><ruleref uri="#setBand"/></item>
      <item><ruleref uri="#setMode"/></item>
      <item><ruleref uri="#swapVfo"/></item>
      <item><ruleref uri="#nudgeFreq"/></item>
    </one-of>
  </rule>

  <!-- ====================================================================
       SetFrequency
       Spoken: "set frequency to 14 point 0 7 4 [megahertz]"
                "tune to 7 point 0 7 4"
                "set the frequency tae 28 point 5 0 0"   (Scots)
  ==================================================================== -->
  <rule id="setFrequency" scope="public">
    <one-of>
      <item>set frequency</item>
      <item>set the frequency</item>
      <item>tune</item>
    </one-of>
    <one-of>
      <item>to</item>
      <item>tae</item>
    </one-of>
    <ruleref uri="#mhzWhole"/>
    <tag>out.mhz = rules.latest("mhzWhole");</tag>
    <item repeat="0-1">
      point
      <ruleref uri="#fracDigit"/>
      <tag>out.frac = rules.latest("fracDigit") * 100;</tag>
      <item repeat="0-1">
        <ruleref uri="#fracDigit"/>
        <tag>out.frac = out.frac + rules.latest("fracDigit") * 10;</tag>
        <item repeat="0-1">
          <ruleref uri="#fracDigit"/>
          <tag>out.frac = out.frac + rules.latest("fracDigit");</tag>
        </item>
      </item>
    </item>
    <item repeat="0-1">
      <one-of>
        <item>megahertz</item>
        <item>mega hertz</item>
      </one-of>
    </item>
    <tag>
      if (out.frac === undefined) out.frac = 0;
      out.intent = "SetFrequency";
      out.hz = out.mhz * 1000000 + out.frac * 1000;
    </tag>
  </rule>

  <!-- ====================================================================
       SetBand — operator-friendly aliases mapped to metres
       Spoken: "go to twenty metres", "twenty metre band",
                "go tae forty metres" (Scots)
  ==================================================================== -->
  <rule id="setBand" scope="public">
    <one-of>
      <item>
        <one-of>
          <item>go to</item>
          <item>go tae</item>
          <item>switch to</item>
          <item>switch tae</item>
        </one-of>
        <ruleref uri="#bandMetres"/>
        <item repeat="0-1">
          <one-of>
            <item>metres</item>
            <item>meters</item>
            <item>metre band</item>
            <item>meter band</item>
            <item>m band</item>
          </one-of>
        </item>
        <tag>out.intent = "SetBand"; out.metres = rules.latest("bandMetres");</tag>
      </item>
      <item>
        <ruleref uri="#bandMetres"/>
        <one-of>
          <item>metre band</item>
          <item>meter band</item>
        </one-of>
        <tag>out.intent = "SetBand"; out.metres = rules.latest("bandMetres");</tag>
      </item>
    </one-of>
  </rule>

  <rule id="bandMetres" scope="public">
    <one-of>
      <item>one hundred and sixty<tag>out=160;</tag></item>
      <item>eighty<tag>out=80;</tag></item>
      <item>sixty<tag>out=60;</tag></item>
      <item>forty<tag>out=40;</tag></item>
      <item>thirty<tag>out=30;</tag></item>
      <item>twenty<tag>out=20;</tag></item>
      <item>seventeen<tag>out=17;</tag></item>
      <item>fifteen<tag>out=15;</tag></item>
      <item>twelve<tag>out=12;</tag></item>
      <item>ten<tag>out=10;</tag></item>
      <item>six<tag>out=6;</tag></item>
      <item>four<tag>out=4;</tag></item>
    </one-of>
  </rule>

  <!-- ====================================================================
       SetMode
       Spoken: "set mode U S B", "mode L S B", "switch to C W"
       Letters phonetic — SAPI struggles with USB as one syllable.
  ==================================================================== -->
  <rule id="setMode" scope="public">
    <one-of>
      <item>set mode</item>
      <item>mode</item>
      <item>set the mode to</item>
      <item>switch to</item>
      <item>switch tae</item>
    </one-of>
    <one-of>
      <item>u s b<tag>out.mode = "USB";</tag></item>
      <item>upper sideband<tag>out.mode = "USB";</tag></item>
      <item>l s b<tag>out.mode = "LSB";</tag></item>
      <item>lower sideband<tag>out.mode = "LSB";</tag></item>
      <item>c w<tag>out.mode = "CW-U";</tag></item>
      <item>see double you<tag>out.mode = "CW-U";</tag></item>
      <item>a m<tag>out.mode = "AM";</tag></item>
      <item>f m<tag>out.mode = "FM";</tag></item>
      <item>data<tag>out.mode = "DATA-U";</tag></item>
      <item>data u<tag>out.mode = "DATA-U";</tag></item>
      <item>data l<tag>out.mode = "DATA-L";</tag></item>
      <item>digital<tag>out.mode = "DATA-U";</tag></item>
      <item>r t t y<tag>out.mode = "RTTY-L";</tag></item>
    </one-of>
    <tag>out.intent = "SetMode";</tag>
  </rule>

  <!-- ====================================================================
       SwapVFO
       Spoken: "swap V F O", "swap A and B", "swap A B", "switch V F O"
  ==================================================================== -->
  <rule id="swapVfo" scope="public">
    <one-of>
      <item>swap v f o</item>
      <item>swap v f os</item>
      <item>swap a and b</item>
      <item>swap a b</item>
      <item>switch v f o</item>
      <item>switch a and b</item>
    </one-of>
    <tag>out.intent = "SwapVFO";</tag>
  </rule>

  <!-- ====================================================================
       NudgeFrequency — step the currently-selected digit up or down by one.
       Spoken: "tune up", "step up", "frequency up", "up one step"
                "tune down", "step down", "frequency down"
  ==================================================================== -->
  <rule id="nudgeFreq" scope="public">
    <one-of>
      <item>
        <one-of>
          <item>tune up</item>
          <item>step up</item>
          <item>frequency up</item>
          <item>up one step</item>
          <item>tune higher</item>
        </one-of>
        <tag>out.intent = "NudgeFrequency"; out.direction = 1;</tag>
      </item>
      <item>
        <one-of>
          <item>tune down</item>
          <item>step down</item>
          <item>frequency down</item>
          <item>down one step</item>
          <item>tune lower</item>
        </one-of>
        <tag>out.intent = "NudgeFrequency"; out.direction = -1;</tag>
      </item>
    </one-of>
  </rule>

  <!-- ====================================================================
       Helper rules
  ==================================================================== -->

  <!-- Whole MHz: amateur HF + 6m + 4m. Two-word constructions for 21-75
       come from natural English ("twenty one", "fifty"). Single-token
       items for round decades save SAPI from a long disjunction. -->
  <rule id="mhzWhole" scope="public">
    <one-of>
      <item>one<tag>out=1;</tag></item>
      <item>two<tag>out=2;</tag></item>
      <item>three<tag>out=3;</tag></item>
      <item>four<tag>out=4;</tag></item>
      <item>five<tag>out=5;</tag></item>
      <item>six<tag>out=6;</tag></item>
      <item>seven<tag>out=7;</tag></item>
      <item>eight<tag>out=8;</tag></item>
      <item>nine<tag>out=9;</tag></item>
      <item>ten<tag>out=10;</tag></item>
      <item>eleven<tag>out=11;</tag></item>
      <item>twelve<tag>out=12;</tag></item>
      <item>thirteen<tag>out=13;</tag></item>
      <item>fourteen<tag>out=14;</tag></item>
      <item>fifteen<tag>out=15;</tag></item>
      <item>sixteen<tag>out=16;</tag></item>
      <item>seventeen<tag>out=17;</tag></item>
      <item>eighteen<tag>out=18;</tag></item>
      <item>nineteen<tag>out=19;</tag></item>
      <item>twenty<tag>out=20;</tag></item>
      <item>twenty one<tag>out=21;</tag></item>
      <item>twenty four<tag>out=24;</tag></item>
      <item>twenty eight<tag>out=28;</tag></item>
      <item>twenty nine<tag>out=29;</tag></item>
      <item>thirty<tag>out=30;</tag></item>
      <item>fifty<tag>out=50;</tag></item>
      <item>fifty one<tag>out=51;</tag></item>
      <item>fifty two<tag>out=52;</tag></item>
      <item>seventy<tag>out=70;</tag></item>
      <item>seventy one<tag>out=71;</tag></item>
    </one-of>
  </rule>

  <!-- Single digits 0-9 (for fractional MHz after "point") -->
  <rule id="fracDigit" scope="public">
    <one-of>
      <item>zero<tag>out=0;</tag></item>
      <item>oh<tag>out=0;</tag></item>
      <item>one<tag>out=1;</tag></item>
      <item>two<tag>out=2;</tag></item>
      <item>three<tag>out=3;</tag></item>
      <item>four<tag>out=4;</tag></item>
      <item>five<tag>out=5;</tag></item>
      <item>six<tag>out=6;</tag></item>
      <item>seven<tag>out=7;</tag></item>
      <item>eight<tag>out=8;</tag></item>
      <item>nine<tag>out=9;</tag></item>
    </one-of>
  </rule>

</grammar>
