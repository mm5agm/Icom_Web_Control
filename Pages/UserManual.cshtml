@page
@model Icom_Web_Control.Pages.UserManualModel
@{
    ViewData["Title"] = "User Manual";
}

@*
    Renders USER_MANUAL.md via Markdig (see UserManual.cshtml.cs).
    Single source of truth — edit USER_MANUAL.md and the change appears here
    on next page load with no separate Razor update.
*@

<style>
    /* Sensible defaults for the rendered markdown. Bootstrap supplies the
       overall page chrome; this targets the manual body specifically. */
    .manual-body { max-width: 980px; }
    .manual-body h1 { font-size: 2.0rem; margin-top: 1.5rem; }
    .manual-body h2 { font-size: 1.5rem; margin-top: 2.0rem; padding-bottom: .25rem; border-bottom: 1px solid #ddd; scroll-margin-top: 70px; }
    .manual-body h3 { font-size: 1.2rem; margin-top: 1.5rem; scroll-margin-top: 70px; }
    .manual-body h4 { font-size: 1.05rem; margin-top: 1.25rem; }
    .manual-body img { max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 4px; margin: 0.5rem 0; }
    .manual-body table { border-collapse: collapse; margin: 0.75rem 0; }
    .manual-body table th, .manual-body table td { border: 1px solid #ccc; padding: .35rem .6rem; vertical-align: top; }
    .manual-body table th { background: #f1f3f5; }
    .manual-body code { background: #f6f8fa; padding: .1rem .35rem; border-radius: 3px; font-size: 0.92em; }
    .manual-body pre { background: #f6f8fa; padding: 0.75rem; border-radius: 4px; overflow-x: auto; }
    .manual-body pre > code { background: transparent; padding: 0; }
    .manual-body blockquote { border-left: 4px solid #b8d4ff; background: #f3f8ff; padding: 0.5rem 1rem; margin: 0.75rem 0; color: #333; }
    .manual-body blockquote p:last-child { margin-bottom: 0; }
    .manual-body hr { border: 0; border-top: 1px solid #ddd; margin: 1.5rem 0; }
    .manual-body ul, .manual-body ol { padding-left: 1.5rem; }
    /* Table of Contents at the top of USER_MANUAL.md renders as a long
       nested list — give it a subtle box so it reads as a TOC, not body
       prose. The first <ol> after the first <h2>"Table of Contents" is the
       TOC; we can't target it without JS, so a simple class isn't possible
       here. Acceptable as-is. */
</style>

<div class="mt-3">
    <div class="d-flex align-items-center mb-2">
        <h2 class="mb-0"><i class="bi bi-book"></i> User Manual</h2>
        <span class="ms-3 text-muted small">
            Rendered from <code>USER_MANUAL.md</code> — also viewable on
            <a href="https://github.com/mm5agm/Icom_Web_Control/blob/main/USER_MANUAL.md" target="_blank" rel="noopener">GitHub</a>.
        </span>
    </div>

    @if (!string.IsNullOrEmpty(Model.LoadError))
    {
        <div class="alert alert-danger">
            <strong>Couldn't load the manual.</strong> @Model.LoadError
        </div>
    }
    else
    {
        <article class="manual-body">
            @Html.Raw(Model.ManualHtml)
        </article>
    }
</div>
