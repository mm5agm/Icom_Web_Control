        // button gives you; the button face shows the HALF-width either side of
        // centre, which is how the radio's own scope menu states it. So
        // spanA5k is the ±2.5k button. Keep the key names in step with the
        // data-a11y-key attributes in Index.cshtml, not with the face labels.
        ["spectrum.spanA5k"]       = "VFO A span ±2.5 kHz button",
        ["spectrum.spanA10k"]      = "VFO A span ±5 kHz button",
        ["spectrum.spanA20k"]      = "VFO A span ±10 kHz button",
        ["spectrum.spanA50k"]      = "VFO A span ±25 kHz button",
        ["spectrum.spanA100k"]     = "VFO A span ±50 kHz button",
        ["spectrum.spanA200k"]     = "VFO A span ±100 kHz button",
        ["spectrum.spanA500k"]     = "VFO A span ±250 kHz button",
        ["spectrum.spanA1m"]       = "VFO A span ±500 kHz button",
        ["spectrum.spanB5k"]       = "VFO B span ±2.5 kHz button",
        ["spectrum.spanB10k"]      = "VFO B span ±5 kHz button",
        ["spectrum.spanB20k"]      = "VFO B span ±10 kHz button",
        ["spectrum.spanB50k"]      = "VFO B span ±25 kHz button",
        ["spectrum.spanB100k"]     = "VFO B span ±50 kHz button",
        ["spectrum.spanB200k"]     = "VFO B span ±100 kHz button",
        ["spectrum.spanB500k"]     = "VFO B span ±250 kHz button",
        ["spectrum.spanB1m"]       = "VFO B span ±500 kHz button",
        // Navigation
        ["nav.brand"]              = "Application name / home link"
    };
}

<div class="mt-4">

    <div class="mb-3">
        <h2>Accessibility Labels</h2>
        <p class="text-muted mb-0">
            These labels are announced by screen readers (NVDA, Narrator, JAWS) when navigating controls.
            Edit the <strong>Label</strong> column, then click <strong>Save Labels</strong>.
            Reload the main page after saving for changes to take effect.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert @(Model.StatusMessage.Contains("✓") ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form method="post">
        <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 g-3 mb-3">
        @foreach (var (sKey, sTitle, sDesc, hClass) in sectionMeta)
        {
            var sectionKeys = descriptions.Keys.Where(k => k.StartsWith(sKey + ".")).ToList();

            <div class="col">
                <div class="card h-100">
                    <div class="card-header @hClass d-flex align-items-baseline gap-2 py-2">
                        <strong>@sTitle</strong>
                        <small class="text-muted">@sDesc</small>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-striped mb-0">
                            <colgroup>
                                <col style="width: 48%" />
                                <col />
                            </colgroup>
                            <tbody>
                                @foreach (var fullKey in sectionKeys)
                                {
                                    <tr>
                                        <td class="ps-2 align-middle text-muted small">@descriptions[fullKey]</td>
                                        <td class="pe-2 py-1">
                                            <input name="Labels[@fullKey]"
                                                   value="@Model.Labels.GetValueOrDefault(fullKey, "")"
                                                   class="form-control form-control-sm"
                                                   aria-label="Label for: @descriptions[fullKey]" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        </div>

        <div class="mb-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i> Save Labels
            </button>
        </div>
    </form>

    <form method="post" asp-page-handler="Reset"
          onsubmit="return confirm('Reset all labels to factory defaults? Your current labels will be lost.')">
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-counterclockwise"></i> Reset to Defaults
        </button>
    </form>

</div>
