    <!-- Backup / Restore — outside the main form so the import button doesn't trigger a save -->
    <details class="settings-section" @(ViewContext.ModelState.IsValid ? "" : "open")>
        <summary><i class="bi bi-box-arrow-up" aria-hidden="true"></i>&nbsp;Backup &amp; Restore</summary>
        <div class="section-body">
            <p class="text-muted">
                Download a single zip file containing everything you've customised in IWC — settings, memories, memory banks, calibration, and accessible-label overrides.
                Use it to safeguard your configuration, move to a new PC, or share a setup with another operator.
            </p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <a class="btn btn-outline-primary" href="/api/backup/export">
                    <i class="bi bi-download"></i> Export full backup
                </a>
                <label class="btn btn-outline-warning mb-0" for="backupImportFile">
                    <i class="bi bi-upload"></i> Import full backup…
                </label>
                <input type="file" id="backupImportFile" accept="application/zip,.zip" hidden>
                <span id="backupImportStatus" class="ms-2 small"></span>
            </div>
            <p class="text-muted small mt-2 mb-0">
                Import overwrites the matching files in your user-data folder. Each replaced file is kept as a <code>.bak</code> so you can recover.
                After importing, <strong>restart the app</strong> so the radio-connection, DX-cluster and rigctld services pick up the new values.
                Radio state (live frequency, mode etc.) is not included in the backup — it resets to whatever the radio reports on next connect.
            </p>
        </div>
    </details>
</div>

<script>
    (function () {
        const fileInput = document.getElementById('backupImportFile');
        const statusEl  = document.getElementById('backupImportStatus');
        if (!fileInput) return;
        fileInput.addEventListener('change', async () => {
            if (!fileInput.files || fileInput.files.length === 0) return;
            const file = fileInput.files[0];
            if (!confirm(`Replace IWC's user data with the contents of "${file.name}"?\n\nMatching files in your user-data folder will be overwritten. Each replaced file is kept as a .bak.`)) {
                fileInput.value = '';
                return;
            }
            statusEl.textContent = 'Importing…';
            statusEl.className = 'ms-2 small text-muted';
            const fd = new FormData();
            fd.append('file', file);
            try {
                const r = await fetch('/api/backup/import', { method: 'POST', body: fd });
                const data = await r.json().catch(() => ({}));
                if (!r.ok) {
                    statusEl.textContent = `Import failed: ${data.error || r.statusText}`;
                    statusEl.className = 'ms-2 small text-danger';
                    return;
                }
                statusEl.textContent = `Imported ${data.restored} file${data.restored === 1 ? '' : 's'}. Please restart the app.`;
                statusEl.className = 'ms-2 small text-success';
                alert(data.message || 'Backup imported. Restart the app for all changes to take effect.');
            } catch (e) {
                statusEl.textContent = `Import failed: ${e.message}`;
                statusEl.className = 'ms-2 small text-danger';
            } finally {
                fileInput.value = '';
            }
        });
    })();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Per-section "Save Settings" buttons. Colin: scrolling to the single
        // Save button at the bottom of a long page is tedious, so give every
        // section its own. They are plain type=submit buttons inside
        // #settingsForm, so they post the whole form exactly like the main
        // button and go through the same jQuery-validate submit handler below.
        // Injected in JS to stay DRY — one button definition — rather than
        // repeating markup in every <details>.
        //
        // Left-aligned (Colin's preference — easier to find at the margin than
        // hunting the right edge). A section can also mark an extra insertion
        // point with a .section-save-anchor element so a very long section (e.g.
        // Voice Control, whose Voice Phrases editor keeps growing) gets a Save
        // button partway down — a user who changed a control up top needn't
        // scroll past everything below it to save.
        (function () {
            var form = document.getElementById('settingsForm');
            if (!form) return;
            function makeSaveRow() {
                var row = document.createElement('div');
                row.className = 'section-save-row mt-3 pt-3 border-top text-start';
                var btn = document.createElement('button');
                btn.type = 'submit';
                btn.className = 'btn btn-primary btn-sm';
                btn.innerHTML = '<i class="bi bi-save"></i> Save Settings';
                row.appendChild(btn);
                return row;
            }
            // Mid-section anchors first (a Save button before the anchored element).
            form.querySelectorAll('.section-save-anchor').forEach(function (anchor) {
                anchor.parentNode.insertBefore(makeSaveRow(), anchor);
            });
            // Then one at the end of every section body.
            form.querySelectorAll('.section-body').forEach(function (body) {
                body.appendChild(makeSaveRow());
            });
        })();
    </script>
    <script>
        // Must run AFTER _ValidationScriptsPartial so jQuery Validate is present.
        // "Saving…" only when the form will actually POST. Previously the spinner
        // ran even when unobtrusive validation cancelled the post (blank optional
        // fields with implicit [Required]) — looked like a save that "didn't persist".
        (function () {
            var form = document.getElementById('settingsForm');
            var btn = document.getElementById('saveSettingsBtn');
            var icon = document.getElementById('saveSettingsIcon');
            var label = document.getElementById('saveSettingsLabel');
            if (!form || !btn || !icon || !label) return;

            function resetSaveButton() {
                btn.disabled = false;
                icon.className = 'bi bi-save';
                label.textContent = 'Save Settings';
            }

            function markSaving() {
                btn.disabled = true;
                icon.className = 'spinner-border spinner-border-sm';
                label.textContent = 'Saving…';
            }

            function revealFirstInvalid() {
                var invalid = form.querySelector('.input-validation-error, :invalid');
                if (!invalid) return;
                var section = invalid.closest('details.settings-section');
                if (section) section.open = true;
                invalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (typeof invalid.focus === 'function') invalid.focus();
            }

            if (window.jQuery) {
                var $form = window.jQuery(form);
                $form.on('invalid-form.validate', function () {
                    resetSaveButton();
                    revealFirstInvalid();
                });
                // Only flip the button to Saving… when Validate says the post may proceed.
                $form.on('submit', function (e) {
                    if ($form.data('validator') && !$form.valid()) {
                        e.preventDefault();
                        resetSaveButton();
                        revealFirstInvalid();
                        return;
                    }
                    markSaving();
                });
            } else {
                form.addEventListener('submit', function (e) {
                    if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
                        e.preventDefault();
                        resetSaveButton();
                        revealFirstInvalid();
                        return;
                    }
                    markSaving();
                });
            }

            if (btn.dataset.saveSuccess === '1') {
                setTimeout(function () {
                    icon.className = 'bi bi-save';
                    label.textContent = 'Save Settings';
                }, 3000);
            }
        })();
    </script>
    <script type="module">
        // DX cluster connection test — POSTs the current Settings-page values
        // (host, port, callsign) to /api/dxcluster/test, which opens a TCP
        // connection, sends the callsign, reads ~10 s of output, and returns
        // the transcript. Result is shown in a Bootstrap modal.
        window.testDxCluster = async function () {
            const host = document.getElementById('Settings_DxClusterHost').value.trim();
            const port = parseInt(document.getElementById('Settings_DxClusterPort').value, 10);
            const callsign = document.getElementById('Settings_DxClusterLoginCallsign').value.trim();

            const statusEl = document.getElementById('dxClusterTestStatus');
            const transcriptEl = document.getElementById('dxClusterTestTranscript');
            statusEl.className = 'alert alert-info';
            statusEl.textContent = `Connecting to ${host}:${port}…  (waits up to ~10 seconds)`;
            transcriptEl.textContent = '';

            const modalEl = document.getElementById('dxClusterTestModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            const btn = document.getElementById('dxClusterTestBtn');
            // Reset to the "untested" yellow state on every click — so if a
            // previous click left it green, retesting a different host shows
            // visual feedback for the new attempt rather than carrying over
            // a stale result.
            btn.classList.remove('btn-success');
            btn.classList.add('btn-warning');
            btn.innerHTML = '<i class="bi bi-broadcast"></i> Test cluster connection';
            btn.disabled = true;
            try {
                const resp = await fetch('/api/dxcluster/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ host, port, loginCallsign: callsign }),
                });
                const r = await resp.json();
                statusEl.className = r.success ? 'alert alert-success' : 'alert alert-danger';
                statusEl.textContent = r.status || (r.success ? 'OK' : 'Failed');
                transcriptEl.textContent = r.transcript || '(no data received)';
                if (r.success) {
                    // Solid green button + checkmark + confirmation text
                    // = unambiguous "this cluster is working". Stays green
                    // until the user clicks the button again.
                    btn.classList.remove('btn-warning');
                    btn.classList.add('btn-success');
                    btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Cluster connection successful';
                }
            } catch (e) {
                statusEl.className = 'alert alert-danger';
                statusEl.textContent = `Error contacting the test endpoint: ${e.message}`;
            } finally {
                btn.disabled = false;
            }
        };
    </script>
    <script>
        function copyToClipboard(elementId) {
            const element = document.getElementById(elementId);
            const text = element.textContent;
            navigator.clipboard.writeText(text).then(() => {
                // Visual feedback
                const button = event.target.closest('button');
                const originalHTML = button.innerHTML;
                button.innerHTML = '<i class="bi bi-check"></i> Copied!';
                button.classList.remove('btn-outline-primary');
                button.classList.add('btn-success');
                setTimeout(() => {
                    button.innerHTML = originalHTML;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-primary');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy:', err);
                alert('Failed to copy to clipboard');
            });
        }

        async function testConnection() {
            const btn = event.target;
            const originalHTML = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Testing...';

            try {
                const response = await fetch('/api/cat/reinitialize', { method: 'POST' });
                const data = await response.json();

                if (data.success) {
                    // Show 'Connected!' briefly, then revert the button so the
                    // user can stay on Settings and continue tweaking. (The
                    // earlier UX redirected to home after success, which made
                    // sense when this button was 'Reinitialize' but is jarring
                    // now that it's a confirmation-only Test Connection.)
                    btn.innerHTML = '<i class="bi bi-check-circle"></i> ' + (data.message || 'Connected!');
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-info');
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.classList.remove('btn-info');
                        btn.classList.add('btn-success');
                        btn.disabled = false;
                    }, 3000);
                } else {
                    btn.innerHTML = '<i class="bi bi-x-circle"></i> Failed';
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-danger');
                    alert(data.message || 'Connection failed. Check your settings and radio.');
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.classList.remove('btn-danger');
                        btn.classList.add('btn-success');
                        btn.disabled = false;
                    }, 3000);
                }
            } catch (err) {
                btn.innerHTML = '<i class="bi bi-x-circle"></i> Error';
                btn.classList.add('btn-danger');
                alert('Error testing connection: ' + err.message);
                setTimeout(() => {
                    btn.innerHTML = originalHTML;
                    btn.classList.remove('btn-danger');
                    btn.classList.add('btn-success');
                    btn.disabled = false;
                }, 3000);
            }
        }

    </script>
    <script>
        (function () {
            const input = document.getElementById('Settings_TxToggleKey');
            const setBtn = document.getElementById('txToggleKeySetBtn');
            const clearBtn = document.getElementById('txToggleKeyClearBtn');
            const badge = document.getElementById('txToggleKeyCaptureBadge');
            const display = document.getElementById('txToggleKeyDisplay');
            if (!input || !setBtn || !clearBtn || !badge || !display) return;

            // Seed from a JSON-encoded server value (not the asp-for attribute).
            // A lone space character cannot round-trip through an HTML form /
            // input value attribute — browsers and Tag Helpers treat
            // whitespace-only as empty, so Space used to save as "" and show
            // "Disabled". We store the KeyboardEvent.code token "Space"
            // instead; migrate any legacy " " on load.
            const serverKeyRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Settings.TxToggleKey ?? string.Empty));
            input.value = (serverKeyRaw === ' ') ? 'Space' : serverKeyRaw;

            let captureActive = false;

            function friendlyKeyLabel(key) {
                if (!key) return 'Disabled';
                if (key === ' ' || key === 'Space') return 'Space';
                if (key === 'Escape') return 'Esc';
                return key.length === 1 ? key.toUpperCase() : key;
            }

            function renderCurrentKey() {
                display.textContent = input.value
                    ? `Current shortcut: ${friendlyKeyLabel(input.value)}`
                    : 'Current shortcut: Disabled';
            }

            function stopCapture() {
                captureActive = false;
                badge.style.display = 'none';
                setBtn.classList.remove('btn-primary');
                setBtn.classList.add('btn-outline-primary');
            }

            function startCapture() {
                captureActive = true;
                badge.style.display = 'inline-block';
                setBtn.classList.remove('btn-outline-primary');
                setBtn.classList.add('btn-primary');
                // Drop focus from the button so pressing Space to choose the
                // shortcut doesn't also re-activate the focused "Set key"
                // button (Space/Enter fire a click on a focused button),
                // which would immediately re-arm capture.
                setBtn.blur();
            }

            setBtn.addEventListener('click', function () {
                if (captureActive) {
                    stopCapture();
                    return;
                }
                startCapture();
            });

            clearBtn.addEventListener('click', function () {
                input.value = '';
                stopCapture();
                renderCurrentKey();
            });

            document.addEventListener('keydown', function (e) {
                if (!captureActive) return;
                e.preventDefault();
                e.stopPropagation();

                if (e.key === 'Tab') {
                    stopCapture();
                    renderCurrentKey();
                    return;
                }

                // e.key for Space is " "; store "Space" so the value survives
                // HTML form post / asp-for round-trips (whitespace-only does not).
                input.value = (e.key === ' ') ? 'Space' : e.key;
                stopCapture();
                renderCurrentKey();
            }, true);

            renderCurrentKey();
        })();
    </script>
}
