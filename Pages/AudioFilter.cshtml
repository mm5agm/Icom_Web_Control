@page
@model Icom_Web_Control.Pages.AudioFilterModel
@{
    Layout = null;
    ViewData["Title"] = "Twin PBT";
    var vfo = Model.Vfo;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-app-version" content="@Icom_Web_Control.AppVersion.Display">
    <title>Twin PBT VFO @vfo - Icom Web Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; margin: 0; background: #222; color: #eee; overflow: hidden; }
        /* The panel is the whole window here, not a floating dialog: the
           window's own frame does the moving and resizing. */
        dialog.audio-filter-popout {
            position: static;
            display: block;
            width: 100%;
            height: 100%;
            max-width: none;
            max-height: none;
            margin: 0;
            padding: 0;
            border: 0;
            background: #222;
            color: #eee;
            overflow: auto;
        }
        .popout-screen-offer {
            font-size: 0.85rem; color: #cde; background: rgba(120, 170, 255, 0.10);
            border-left: 3px solid #78aaff; border-radius: 0.25rem;
            padding: 0.4rem 0.6rem;
        }
    </style>
</head>
<body>
    <partial name="_AudioFilterPartial" model="(vfo, true)" />

    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    @* Builds the hub connection with a retry policy that never gives up.
       This page has no _Layout, so it must load it itself. *@
    <script src="~/js/hub/hub-connection.js" asp-append-version="true"></script>
    <script type="module">
        import { AudioFilterPanel } from "/js/ui/audio-filter-panel.js?v=@Icom_Web_Control.AppVersion.Display";
        import { PopoutChild, offerScreenPermission } from "/js/popout/popout.js?v=@Icom_Web_Control.AppVersion.Display";

        const vfo = '@vfo';
        const popout = new PopoutChild({ name: 'audio-filter-' + vfo.toLowerCase(), fallbackUrl: '/' }).start();
        offerScreenPermission(document.querySelector('#audioFilterDialog' + vfo + ' .p-3'));
        document.getElementById('audioFilterReattachBtn' + vfo)
            ?.addEventListener('click', () => popout.reattach());

        const panel = new AudioFilterPanel(vfo).init();
        panel.refresh();

        // Re-read on this VFO's mode changes, as the main page's dialog
        // does, and on a reconnect in case anything moved while the link was
        // down.
        const conn = window.rwcHubConnection('/radioHub');
        conn.on('RadioStateUpdate', update => {
            if (update.property === 'Mode' + vfo) panel.onModeChanged(vfo);
        });
        conn.onreconnected(() => panel.refresh());
        // IWC's host decides when to shut down by the connections that send
        // the heartbeat, which the main page does from site.js. This window has
        // no site.js, so it sends its own: a pop-out left open on its own then
        // keeps the host running, as the main page does.
        const heartbeat = () => conn.invoke('Heartbeat').catch(() => { });
        setInterval(heartbeat, 5000);
        conn.start().then(heartbeat).catch(err => console.error('[audio-filter-popout]', err));
    </script>
</body>
</html>
