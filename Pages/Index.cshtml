        <span class="fkb-title" id="freqKeyboardTitle">VFO A Frequency</span>
        <button class="fkb-close" id="freqKeyboardClose" aria-label="Close frequency keyboard" title="Close frequency keyboard" data-a11y-key="keyboard.close">✕</button>
    </div>
    <div class="fkb-display-row">
        <div class="fkb-display" id="freqKeyboardDisplay" role="status" aria-live="polite" aria-label="Entered frequency"></div>
        <span class="fkb-mhz-label" aria-hidden="true">MHz</span>
    </div>
    <div class="fkb-error" id="freqKeyboardError" role="alert" aria-live="assertive"></div>
    <div class="fkb-pad">
        <button class="fkb-key fkb-num" data-digit="7" aria-label="7" title="7" data-a11y-key="keyboard.digit7">7</button>
        <button class="fkb-key fkb-num" data-digit="8" aria-label="8" title="8" data-a11y-key="keyboard.digit8">8</button>
        <button class="fkb-key fkb-num" data-digit="9" aria-label="9" title="9" data-a11y-key="keyboard.digit9">9</button>
        <button class="fkb-key fkb-nav" id="freqKbLeft"  aria-label="Move cursor left"  title="Move cursor left"  data-a11y-key="keyboard.cursorLeft">◀</button>
        <button class="fkb-key fkb-num" data-digit="4" aria-label="4" title="4" data-a11y-key="keyboard.digit4">4</button>
        <button class="fkb-key fkb-num" data-digit="5" aria-label="5" title="5" data-a11y-key="keyboard.digit5">5</button>
        <button class="fkb-key fkb-num" data-digit="6" aria-label="6" title="6" data-a11y-key="keyboard.digit6">6</button>
        <button class="fkb-key fkb-nav" id="freqKbRight" aria-label="Move cursor right" title="Move cursor right" data-a11y-key="keyboard.cursorRight">▶</button>
        <button class="fkb-key fkb-num" data-digit="1" aria-label="1" title="1" data-a11y-key="keyboard.digit1">1</button>
        <button class="fkb-key fkb-num" data-digit="2" aria-label="2" title="2" data-a11y-key="keyboard.digit2">2</button>
        <button class="fkb-key fkb-num" data-digit="3" aria-label="3" title="3" data-a11y-key="keyboard.digit3">3</button>
        <button class="fkb-key fkb-backspace" id="freqKbBackspace" aria-label="Backspace" title="Backspace" data-a11y-key="keyboard.backspace">⌫</button>
        <button class="fkb-key fkb-num" data-digit="0" aria-label="0" title="0" data-a11y-key="keyboard.digit0">0</button>
        <button class="fkb-key fkb-clear" id="freqKbClear" aria-label="Clear all digits"  title="Clear all digits"  data-a11y-key="keyboard.clear">CLR</button>
        <button class="fkb-key fkb-enter" id="freqKbEnter" aria-label="Enter frequency"   title="Enter frequency"   data-a11y-key="keyboard.enter">↵ Enter</button>
    </div>
</dialog>

@section Scripts {
    <!-- Cache-busted JS reference, placed BEFORE your inline script if you use window.radioControl, etc. -->
    <script>window.bandPlan = '@Model.BandPlan';</script>
    <script type="module">
        import { MeterPanel }           from "/js/guages/meter-panel.js?v=1";
        import { FTdx101Meters }        from "/js/orchestrators/FTdx101Meters.js?v=1";
        import { SdrSpectrumPipeline }  from "/js/sdr/sdr-spectrum-pipeline.js?v=1";
        import { SpectrumPanel }        from "/js/sdr/spectrum-panel.js?v=1";
        import { BAND_PLANS, getSegments } from "/js/ui/band-plan.js?v=1";
        import { loadLabels }           from "/js/ui/a11y-labels.js?v=1";
        import { initFreqKeyboard }     from "/js/ui/freq-keyboard.js?v=14";
        import { initMemoriesPanel }   from "/js/ui/memories.js?v=10";
        window.bandPlanData = BAND_PLANS;
        window.getBandSegments = getSegments;
        loadLabels();
        window.addEventListener('focus', loadLabels);
        document.addEventListener('DOMContentLoaded', function () {
            initFreqKeyboard();
            initMemoriesPanel();
            window.meterPanel = new MeterPanel({
                smeterA:     { type: 'smeter', canvasId: 'sMeterCanvasA' },
                smeterB:     { type: 'smeter', canvasId: 'sMeterCanvasB' },
                power:       { canvasId: 'powerMeterCanvas' },
                swr:         { canvasId: 'swrMeterCanvas' },
                compression: { canvasId: 'compressionMeterCanvas' },
                alc:         { canvasId: 'alcMeterCanvas' },
                temp:        { canvasId: 'tempMeterCanvas' },
                idd:         { canvasId: 'iddMeterCanvas' },
                vdd:         { canvasId: 'vddMeterCanvas' }
            });
            window.ftdx101Meters = new FTdx101Meters(window.meterPanel, window.calibrationEngine);

            // ── Spectrum display ─────────────────────────────────────────────
            // SpectrumPanel owns the canvas and all DOM for the spectrum display.
            // SdrSpectrumPipeline is pure transport/routing — no DOM, no canvas.
            const spectrumPanel = new SpectrumPanel(
                'spectrumCanvas',
                'spectrumContainer',
                @Model.RadioState.FrequencyA   // server-rendered initial VFO A frequency
            );

            const spectrumPipeline = new SdrSpectrumPipeline();

            spectrumPipeline.onSpectrumUpdate(data  => spectrumPanel.update(data));
            spectrumPipeline.onStatusChange(status  => {
                spectrumPanel.setStatus(status);
                const badge = document.getElementById('spectrumStatusBadge');
                if (badge) {
                    const labels = {
                        unconfigured: ['secondary', 'No SDR'],
                        connecting:   ['warning',   'Connecting…'],
                        streaming:    ['success',   'Live'],
                        disconnected: ['danger',    'Disconnected'],
                        nodll:        ['danger',    'No SoapySDR'],
                    };
                    const [colour, text] = labels[status] ?? ['secondary', status];
                    badge.className = `badge bg-${colour} small`;
                    badge.textContent = text;
                }
            });
            spectrumPipeline.onFrequencyA(hz => spectrumPanel.setVfoFrequency(hz));
            spectrumPipeline.onError(detail => spectrumPanel.setError(detail));

            spectrumPipeline.connect();
            window.spectrumPanel = spectrumPanel;

            // Span selector — POST new sample rate and restart the SDR stream.
            document.querySelectorAll('.span-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const hz = btn.dataset.hz;
                    try {
                        const res = await fetch(`/api/sdr/span?hz=${hz}`, { method: 'POST' });
                        if (res.ok) {
                            document.querySelectorAll('.span-btn').forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                        }
                    } catch { /* network error — ignore */ }
                });
            });
        });
        async function launchWsjtx() {
            try {
                const response = await fetch('/api/wsjtx/launch', { method: 'POST' });
                if (response.ok) {
                    const data = await response.json();
                    if (data.alreadyRunning) {
                        console.log('WSJT-X is already running, brought window to front');
                        // Optional: show a brief message to the user
                        const btn = document.getElementById('wsjtxBtn');
                        const originalText = btn.innerHTML;
                        btn.innerHTML = 'WSJT-X Already Running';
                        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
                    }
                } else {
                    const data = await response.json();
                    alert(data.error || 'Failed to launch WSJT-X');
                }
            } catch (e) {
                alert('Error launching WSJT-X: ' + e.message);
            }
        }

        async function updateWsjtxStatus() {
            try {
                const response = await fetch('/api/wsjtx/status');
                if (response.ok) {
                    const data = await response.json();
                    const btn = document.getElementById('wsjtxBtn');
                    const txBadge = document.getElementById('wsjtxTxBadge');

                    // Green = UDP connected (WSJT-X talking to us)
                    // Yellow = process running but no UDP yet
                    // Grey = not running
                    btn.classList.remove('btn-secondary', 'btn-success', 'btn-warning', 'btn-danger');
                    if (data.connected) {
                        btn.classList.add('btn-success');
                        btn.title = 'WSJT-X connected' + (data.mode ? ' \u2014 ' + data.mode : '');
                    } else if (data.running) {
                        btn.classList.add('btn-warning');
                        btn.title = 'WSJT-X running \u2014 waiting for UDP data';
                    } else {
                        btn.classList.add('btn-danger');
                        btn.title = 'WSJT-X is not running';
                    }

                    // Red TX badge when transmitting
                    if (txBadge) {
                        txBadge.style.display = data.transmitting ? 'inline' : 'none';
                    }
                }
            } catch (e) { /* ignore */ }
        }

        updateWsjtxStatus();
        setInterval(updateWsjtxStatus, 5000);

        // JTAlert launch and status functions
        async function launchJtalert() {
            try {
                const response = await fetch('/api/jtalert/launch', { method: 'POST' });
                const btn = document.getElementById('jtalertBtn');
                if (response.ok) {
                    const data = await response.json();
                    btn.classList.remove('btn-secondary');
                    btn.classList.add('btn-success');
                    btn.title = 'JTAlert is running';
                    if (data.alreadyRunning) {
                        console.log('JTAlert is already running, brought window to front');
                        const originalText = btn.innerHTML;
                        btn.innerHTML = 'JTAlert Already Running';
                        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
                    }
                } else {
                    const data = await response.json();
                    alert(data.error || 'Failed to launch JTAlert');
                }
            } catch (e) {
                alert('Error launching JTAlert: ' + e.message);
            }
        }

        async function updateJtalertStatus() {
            try {
                const response = await fetch('/api/jtalert/status');
                if (response.ok) {
                    const data = await response.json();
                    console.log('[JTAlert Status Poll]', data); // Debug log
                    const btn = document.getElementById('jtalertBtn');

                    btn.classList.remove('btn-secondary', 'btn-success', 'btn-warning', 'btn-danger');
                    if (data.running) {
                        btn.classList.add('btn-success');
                        btn.title = 'JTAlert is running';
                    } else {
                        btn.classList.add('btn-danger');
                        btn.title = 'JTAlert is not running';
                    }
                }
            } catch (e) { /* ignore */ }
        }

        updateJtalertStatus();
        setInterval(updateJtalertStatus, 5000);

        // Log4OM launch and status functions
        async function launchLog4om() {
            try {
                const response = await fetch('/api/log4om/launch', { method: 'POST' });
                const btn = document.getElementById('log4omBtn');
                if (response.ok) {
                    const data = await response.json();
                    btn.classList.remove('btn-secondary');
                    btn.classList.add('btn-success');
                    btn.title = 'Log4OM is running';
                    if (data.alreadyRunning) {
                        console.log('Log4OM is already running, brought window to front');
                        const originalText = btn.innerHTML;
                        btn.innerHTML = 'Log4OM Already Running';
                        setTimeout(() => { btn.innerHTML = originalText; }, 2000);
                    }
                } else {
                    const data = await response.json();
                    alert(data.error || 'Failed to launch Log4OM');
                }
            } catch (e) {
                alert('Error launching Log4OM: ' + e.message);
            }
        }

        async function updateLog4omStatus() {
            try {
                const response = await fetch('/api/log4om/status');
                if (response.ok) {
                    const data = await response.json();
                    console.log('[Log4OM Status Poll]', data); // Debug log
                    const btn = document.getElementById('log4omBtn');

                    btn.classList.remove('btn-secondary', 'btn-success', 'btn-warning', 'btn-danger');
                    if (data.running) {
                        btn.classList.add('btn-success');
                        btn.title = 'Log4OM is running';
                    } else {
                        btn.classList.add('btn-danger');
                        btn.title = 'Log4OM is not running';
                    }
                }
            } catch (e) { /* ignore */ }
        }

        updateLog4omStatus();
        setInterval(updateLog4omStatus, 5000);

        async function setMicGain(value) {
            console.log('[setMicGain] Called with value:', value);
            try {
                const response = await fetch('/api/cat/micgain', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ value: parseInt(value) })
                });
                console.log('[setMicGain] API response status:', response.status);
                if (!response.ok) {
                    const data = await response.json();
                    console.error('Failed to set MIC Gain:', data.error);
                } else {
                    console.log('[setMicGain] Successfully set MIC Gain to', value);
                }
            } catch (e) {
                console.error('Error setting MIC Gain:', e.message);
            }
        }

        async function toggleProc() {
            const btn = document.getElementById('procBtn');
            const enabled = btn.classList.contains('btn-warning');
            try {
                const response = await fetch('/api/cat/proc', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: !enabled })
                });
                if (response.ok) {
                    updateProcButton(!enabled);
                }
            } catch (e) {
                console.error('Error toggling PROC:', e.message);
            }
        }

        async function setProcLevel(value) {
            try {
                await fetch('/api/cat/proclevel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ value: parseInt(value) })
                });
            } catch (e) {
                console.error('Error setting PROC level:', e.message);
            }
        }

        function updateProcButton(enabled) {
            const btn = document.getElementById('procBtn');
            if (!btn) return;
            btn.classList.toggle('btn-warning', enabled);
            btn.classList.toggle('btn-outline-secondary', !enabled);
        }

        document.addEventListener('DOMContentLoaded', function() {
        });

        // Expose functions called from HTML onclick/onchange attributes
        window.launchWsjtx  = launchWsjtx;
        window.launchJtalert = launchJtalert;
        window.launchLog4om  = launchLog4om;
        window.setMicGain    = setMicGain;
        window.toggleProc    = toggleProc;
        window.setProcLevel  = setProcLevel;
    </script>
    <script>
    (function () {
        const STORAGE_KEY = 'vfoBVisible';
        function getVisible() {
            const stored = localStorage.getItem(STORAGE_KEY);
            return stored !== null ? stored === 'true' : true;
        }

        function applyVisibility(visible) {
            const aCol  = document.getElementById('vfoACol');
            const bCol  = document.getElementById('vfoBCol');
            const btn   = document.getElementById('vfoBToggleBtn');
            if (bCol) bCol.style.display = visible ? '' : 'none';
            if (aCol) {
                if (visible) {
                    aCol.classList.remove('col-12');
                    aCol.classList.add('col-lg-6');
                } else {
                    aCol.classList.remove('col-lg-6');
                    aCol.classList.add('col-12');
                }
            }
            if (btn) {
                btn.textContent = visible ? 'Hide B' : 'Show B';
                btn.title = visible ? 'Hide VFO-B panel' : 'Show VFO-B panel';
            }
        }

        document.getElementById('vfoBToggleBtn')?.addEventListener('click', function () {
            const newVisible = !getVisible();
            localStorage.setItem(STORAGE_KEY, String(newVisible));
            applyVisibility(newVisible);
        });

        applyVisibility(getVisible());
    })();
    </script>
}