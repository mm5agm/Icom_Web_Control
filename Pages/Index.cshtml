        // --- CONNECT / DISCONNECT ---
        let _catConnected = false;

        function _applyConnectBtnState(connected) {
            const btn = document.getElementById('connectBtn');
            if (!btn) return;
            btn.classList.remove('btn-success', 'btn-danger', 'btn-secondary');
            if (connected) {
                btn.classList.add('btn-success');
                btn.innerHTML = '<i class="bi bi-plug-fill" aria-hidden="true"></i> Connected';
                btn.setAttribute('aria-label', 'CAT serial connection — currently connected');
            } else {
                btn.classList.add('btn-danger');
                btn.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i> Disconnected';
                btn.setAttribute('aria-label', 'CAT serial connection — currently disconnected');
            }
            _catConnected = connected;
            // The spectrum card hangs off the connection, not off the arrival of a
            // sweep — see __spectrumSetConnected in the spectrum block. Guarded
            // because that block is skipped when no scope source is configured.
            if (window.__spectrumSetConnected) window.__spectrumSetConnected(connected);
        }
        window._applyConnectBtnState = _applyConnectBtnState;

        async function toggleCatConnection() {
            const btn = document.getElementById('connectBtn');
            try {
                if (_catConnected) {
                    const r = await fetch('/api/cat/disconnect', { method: 'POST' });
                    if ((await r.json()).success) _applyConnectBtnState(false);
                } else {
                    btn.classList.remove('btn-danger');
                    btn.classList.add('btn-secondary');
                    btn.innerHTML = '<i class="bi bi-plug" aria-hidden="true"></i> Connecting…';
                    const r = await fetch('/api/cat/connect', { method: 'POST' });
                    _applyConnectBtnState((await r.json()).success);
