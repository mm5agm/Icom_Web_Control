        // --- DSP SEGMENTED BUTTON GROUPS ---
        // Highlights the button whose data-val matches `value` within the group,
        // clearing the others. Used both by the inline onclick handlers (instant
        // feedback) and by the SignalR state handlers in site.js (radio -> app).
        window.dspSetActive = function (groupId, value) {
            const group = document.getElementById(groupId);
            if (!group) return;
            const want = String(value);
            group.querySelectorAll('.dsp-seg').forEach(function (btn) {
                const on = btn.getAttribute('data-val') === want;
                btn.classList.toggle('active', on);
                btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
        };

        // --- NOTCH (single OFF / AN / MN control, mirrors the radio's NOTCH button) ---
        // The IC-7300 exposes auto-notch (16 41) and manual-notch (16 48) as two
        // mutually-exclusive functions; the front-panel NOTCH button cycles
        // OFF -> AN -> MN. We present that as one 3-way group and translate a
        // click into the two underlying set commands (disable the other first so
        // the radio never sees both on at once).
        window.setNotchMode = async function (vfo, mode) {
            window.dspSetActive('notchGroup' + vfo, mode);           // instant feedback
            const group = document.getElementById('notchGroup' + vfo);
            if (group) { group.dataset.auto = mode === 'an' ? '1' : '0'; group.dataset.manual = mode === 'mn' ? '1' : '0'; }
            if (mode === 'mn') {
                await window.radioControl.setAutoNotch(vfo, '0');
                await window.radioControl.setManualNotch(vfo, '1');
            } else if (mode === 'an') {
                await window.radioControl.setManualNotch(vfo, '0');
                await window.radioControl.setAutoNotch(vfo, '1');
            } else {
                await window.radioControl.setAutoNotch(vfo, '0');
                await window.radioControl.setManualNotch(vfo, '0');
            }
        };

        // Fold a radio-side auto/manual notch state update (SignalR) into the
        // single 3-way group. Manual wins the display if both somehow report on.
        window.applyNotchState = function (vfo, which, on) {
            const group = document.getElementById('notchGroup' + vfo);
            if (!group) return;
            if (which === 'auto')   group.dataset.auto   = on ? '1' : '0';
            if (which === 'manual') group.dataset.manual = on ? '1' : '0';
            const mode = group.dataset.manual === '1' ? 'mn'
                       : group.dataset.auto   === '1' ? 'an' : 'off';
            window.dspSetActive('notchGroup' + vfo, mode);
        };

        // --- MANUAL NOTCH WIDTH (WIDE / MID / NAR, CI-V 16 57) ---
        window.setManualNotchWidth = async function (vfo, code) {
            window.dspSetActive('mnWidthGroup' + vfo, code);         // instant feedback
            try {
                await fetch(`/api/cat/manualnotchwidth/${vfo.toLowerCase()}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
