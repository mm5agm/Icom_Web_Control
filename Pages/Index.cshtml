<!-- DX Watch (watched-callsign alerts) Dialog -->
<dialog id="dxWatchDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:320px; max-width:420px;" aria-labelledby="dxWatchTitle">
    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444; cursor:move;">
        <strong id="dxWatchTitle">DX Watch</strong>
        <button class="btn btn-sm iwc-dialog-close"
                onclick="document.getElementById('dxWatchDialog').close()"
                aria-label="Close DX watch panel">✕</button>
    </div>
    <div class="p-3 d-flex flex-column gap-2">
        <p class="text-muted small mb-1" style="color:#bbb !important;">
            Get notified when these callsigns are spotted on the DX cluster.
            Use a trailing <code style="color:#ffd">*</code> for prefix match
            (<code style="color:#ffd">G4*</code> matches G4ABC, G4XYZ).
        </p>
        <div class="d-flex align-items-center gap-2">
            <input type="text" id="dxWatchNewInput" class="form-control form-control-sm font-monospace"
                   placeholder="Callsign or prefix*"
                   maxlength="16"
                   style="text-transform:uppercase"
                   aria-label="New watched callsign or prefix">
            <button id="dxWatchAddBtn" class="btn btn-sm btn-success"
                    aria-label="Add to watch list"
                    onclick="window.dxWatchAdd && window.dxWatchAdd()">Add</button>
        </div>
        <hr style="border-color:#444; margin:4px 0;">
        <div class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" id="dxWatchFilterChk">
            <label class="form-check-label small" for="dxWatchFilterChk" style="color:#ddd;">
                Show only watched callsigns
            </label>
        </div>
        <p class="text-muted small mb-2" style="color:#bbb !important; font-size:0.8rem;">
            When ticked, the spectrum overlay and the DX Spots list hide every spot
            except those that match a callsign or prefix in this list.
        </p>
        <div class="fw-bold small" style="color:#aaa;">Watched</div>
        <ul id="dxWatchList" class="list-unstyled mb-0 small" style="max-height:240px; overflow-y:auto;"
            aria-live="polite" aria-label="Watched callsigns list"></ul>
        <div id="dxWatchEmpty" class="text-muted small" style="display:none;">
            No callsigns watched yet. Add one above to get alerts.
        </div>
    </div>
</dialog>

<!-- Twin PBT (Digital Passband Tuning) Dialogs — PBT1 (inner) and PBT2
     (outer) shift values for the IC-7300's single receiver. Each edge is a
     0–255 shift with 128 at centre (no shift). One dialog per VFO button so
     either panel can open it; on the single-receiver IC-7300 both drive the
     same passband. Replaces the Yaesu LCUT/HCUT audio-filter dialog.
     The dialog id stays audioFilterDialog{vfo} so drag-position persistence
     and the close-on-load list keep working. -->
@foreach (var vfo in new[] { "A", "B" })
{
    <dialog id="audioFilterDialog@(vfo)" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:380px; max-width:520px; position:fixed; margin:0;" aria-labelledby="audioFilterDialogTitle@(vfo)">
        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444; cursor:move;">
            <strong id="audioFilterDialogTitle@(vfo)">Twin PBT — VFO @vfo</strong>
            <button class="btn btn-sm" style="background:#c0392b; color:#fff; border:1px solid #e74c3c; font-weight:bold; font-size:1rem; line-height:1; padding:2px 11px;" onclick="document.getElementById('audioFilterDialog@(vfo)').close()" title="Close" aria-label="Close VFO @vfo Twin PBT dialog">✕</button>
        </div>
        <div class="p-3 d-flex flex-column gap-3">
            <div id="audioFilterStatus@(vfo)" class="small text-warning" style="min-height:1.2em;"></div>
            <p class="small text-muted mb-0" style="color:#bbb !important;">
                Shift the two passband edges to narrow the receive filter.
                Centre = no shift; drag toward the ends to cut the low or high side.
            </p>
            <div id="audioFilterControls@(vfo)">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="mb-0 fw-bold" style="min-width:64px;">PBT1:</label>
                    <input type="range" id="pbtInnerSlider@(vfo)"
                           min="0" max="255" step="1" value="128"
                           style="flex:1; height:18px;"
                           aria-label="PBT1 inner shift">
                    <span id="pbtInnerLabel@(vfo)" class="text-end" style="min-width:64px;">Centre</span>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <label class="mb-0 fw-bold" style="min-width:64px;">PBT2:</label>
                    <input type="range" id="pbtOuterSlider@(vfo)"
                           min="0" max="255" step="1" value="128"
                           style="flex:1; height:18px;"
                           aria-label="PBT2 outer shift">
                    <span id="pbtOuterLabel@(vfo)" class="text-end" style="min-width:64px;">Centre</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-light"
                        id="pbtClearBtn@(vfo)"
                        title="Reset both PBT shifts to centre (no passband tuning)"
                        aria-label="Clear Twin PBT">Clear PBT</button>
            </div>
        </div>
    </dialog>
}

<!-- RX Tone Control (HPF/LPF audio filter) Dialogs — CI-V 1A 05. Per-mode
     receive-audio high-pass (low-cut) and low-pass (high-cut) edges; the
     IC-7300's native equivalent of the Yaesu Audio Filter. One dialog per VFO
     button; the values shown are for that VFO's *current mode* (the radio
     stores them per mode, not per VFO). Both edges: HPF Through/100–2000 Hz,
     LPF 500–2400 Hz/Through. Unavailable in SSB-DATA. -->
@foreach (var vfo in new[] { "A", "B" })
{
    <dialog id="rxFilterDialog@(vfo)" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:380px; max-width:520px; position:fixed; margin:0;" aria-labelledby="rxFilterDialogTitle@(vfo)">
        <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444; cursor:move;">
            <strong id="rxFilterDialogTitle@(vfo)">RX Filter — VFO @vfo</strong>
            <button class="btn btn-sm" style="background:#c0392b; color:#fff; border:1px solid #e74c3c; font-weight:bold; font-size:1rem; line-height:1; padding:2px 11px;" onclick="document.getElementById('rxFilterDialog@(vfo)').close()" title="Close" aria-label="Close VFO @vfo RX Filter dialog">✕</button>
        </div>
        <div class="p-3 d-flex flex-column gap-3">
            <div id="rxFilterStatus@(vfo)" class="small text-warning" style="min-height:1.2em;"></div>
            <p class="small text-muted mb-0" style="color:#bbb !important;">
                RX Tone Control for the current mode. HPF cuts the low audio edge;
                LPF cuts the high edge. "Through" = no cut on that edge.
            </p>
            <div id="rxFilterControls@(vfo)">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label class="mb-0 fw-bold" for="rxHpfSelect@(vfo)" style="min-width:64px;">HPF:</label>
                    <select id="rxHpfSelect@(vfo)" class="form-select form-select-sm" style="flex:1;" aria-label="RX high-pass (low-cut) edge">
                        <option value="0">Through</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <label class="mb-0 fw-bold" for="rxLpfSelect@(vfo)" style="min-width:64px;">LPF:</label>
                    <select id="rxLpfSelect@(vfo)" class="form-select form-select-sm" style="flex:1;" aria-label="RX low-pass (high-cut) edge">
                        <option value="0">Through</option>
                    </select>
                </div>
                <button type="button" class="btn btn-sm btn-outline-light"
                        id="rxFilterDefaultBtn@(vfo)"
                        title="Reset to the widest filter (HPF Through, LPF Through)"
                        aria-label="Clear RX Filter">Widest</button>
            </div>
        </div>
    </dialog>
}

<!-- Voice Announcements Dialog -->
<dialog id="voiceDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:340px; max-width:480px;" aria-labelledby="voiceDialogTitle">
    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444; cursor:move;">
        <strong id="voiceDialogTitle">Voice Announcements</strong>
        <button class="btn btn-sm iwc-dialog-close"
                onclick="document.getElementById('voiceDialog').close()"
                aria-label="Close voice announcements panel">✕</button>
    </div>
    <div class="p-3 d-flex flex-column gap-2">
        <p class="text-muted small mb-1" style="color:#bbb !important;">
            Spoken announcements via your browser's text-to-speech engine.
            Useful for partially sighted operators or anyone who wants to
            be told when a setting changes without looking at the screen.
            <br><strong>Note:</strong> If you use a screen reader (NVDA / JAWS),
            leave this off to avoid double announcements.
        </p>

        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="voiceEnabledChk">
            <label class="form-check-label" for="voiceEnabledChk"><strong>Enable voice announcements</strong></label>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:64px;">Voice:</label>
            <select id="voicePickerSelect" class="form-select form-select-sm" style="flex:1;"
                    aria-label="Text-to-speech voice"></select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:64px;">Rate:</label>
            <input type="range" id="voiceRateSlider" min="0.5" max="2.0" step="0.1" value="1.0"
                   style="flex:1;" aria-label="Speech rate">
            <span id="voiceRateValue" class="font-monospace" style="min-width:34px; text-align:right;">1.0×</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="mb-0 text-nowrap" style="min-width:64px;">Volume:</label>
            <input type="range" id="voiceVolumeSlider" min="0" max="1.0" step="0.1" value="1.0"
                   style="flex:1;" aria-label="Speech volume">
            <span id="voiceVolumeValue" class="font-monospace" style="min-width:34px; text-align:right;">100%</span>
        </div>

        <hr style="border-color:#444; margin:4px 0;">
        <div class="fw-bold small" style="color:#aaa;">Announce</div>

        <div class="form-check"><input class="form-check-input" type="checkbox" id="voiceBandChk"><label class="form-check-label" for="voiceBandChk">Band changes ("forty metres")</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="voiceModeChk"><label class="form-check-label" for="voiceModeChk">Mode changes ("upper sideband")</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="voiceTxChk"><label class="form-check-label" for="voiceTxChk">TX / RX state ("transmit" / "receive")</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="voiceFreqChk"><label class="form-check-label" for="voiceFreqChk">Manual frequency entry confirmation</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="voiceDxAlertChk"><label class="form-check-label" for="voiceDxAlertChk">DX watched-callsign alerts</label></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" id="voiceTxTimeoutChk"><label class="form-check-label" for="voiceTxTimeoutChk">TX timeout warning</label></div>

        <div class="d-flex gap-2 mt-2">
            <button id="voiceTestBtn" class="btn btn-sm btn-primary">Test voice</button>
            <button id="voiceStopBtn" class="btn btn-sm btn-outline-secondary">Stop talking</button>
        </div>
    </div>
</dialog>

<!-- Voice command help — opened by RIGHT-CLICKING either mic button. The list
     is generated server-side from the live phrase config (/api/voice/help) so
     it always matches what recognition actually accepts, including any phrases
     the user has customised. Wired in wwwroot/js/ui/voice-control.js. -->
<dialog id="voiceHelpDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:360px; max-width:560px;" aria-labelledby="voiceHelpTitle">
    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444; cursor:move;">
        <strong id="voiceHelpTitle">Voice commands</strong>
        <button class="btn btn-sm iwc-dialog-close"
                onclick="document.getElementById('voiceHelpDialog').close()"
                aria-label="Close voice command help">✕</button>
    </div>
    <div id="voiceHelpBody" class="p-3" style="max-height:70vh; overflow-y:auto;">
        <div class="text-muted small">Loading…</div>
    </div>
</dialog>

<!-- UTC clock info popover — opened by clicking the top-bar clock.
     Explains the clock source, what depends on it, and how to verify
     the PC's time-sync state. -->
<dialog id="utcClockInfoDialog"
        style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:380px; max-width:520px;"
        aria-labelledby="utcClockInfoTitle">
    <div class="d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444; cursor:move;">
        <strong id="utcClockInfoTitle">UTC clock — where does the time come from?</strong>
        <button class="btn btn-sm iwc-dialog-close"
                onclick="document.getElementById('utcClockInfoDialog').close()"
                aria-label="Close UTC clock info">✕</button>
    </div>
    <div class="p-3 small" style="line-height:1.5;">
        <p class="mb-2">The clock reads <strong>your PC's system clock</strong>, converted to UTC. There is no separate network time source.</p>
        <p class="mb-2"><strong>What depends on accurate time:</strong></p>
        <ul class="mb-2 ps-3">
            <li>DX Spots <em>Age</em> and <em>Time UTC</em> columns</li>
            <li>The 15-minute spot age-out</li>
            <li>The TX timeout warning countdown</li>
            <li>QSO timestamps in any external logger you're using</li>
        </ul>
        <p class="mb-2"><strong>How to verify your PC time is correct:</strong></p>
        <ol class="mb-2 ps-3">
            <li>Open Windows <strong>Settings → Time &amp; Language → Date &amp; time</strong>.</li>
            <li>Confirm <strong>Set time automatically</strong> is on.</li>
            <li>Under <strong>Additional settings</strong>, click <strong>Sync now</strong> and check the &quot;Last successful time synchronisation&quot; date. If it&#39;s more than a few days ago and you have no continual internet, your clock may have drifted.</li>
        </ol>
        <p class="mb-2"><strong>If you operate offline a lot:</strong> rough rule of thumb is a typical PC clock drifts seconds-to-minutes per week without sync. Fine for SSB casual logging, problematic for FT8 and contests. Re-sync whenever you reconnect to the internet.</p>
        <p class="mb-0 text-muted">The clock cannot detect drift on its own — your PC&#39;s clock is the only reference IWC has.</p>
    </div>
</dialog>

<!-- DX Spots list panel — filtered list of cluster spots on the current band.
     Works regardless of whether an SDR is configured; data flows over the
     same SignalR DxSpot stream the spectrum overlay uses. -->
<style>
    .dxs-call     { font-weight:600; }
    .dxs-watched  { color:#ff5050; font-weight:bold; }
    .dxs-num      { font-family:monospace; text-align:right; }
    .dxs-mode     { font-family:monospace; }
    .dxs-comment  { color:#bbb; max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    #dxSpotsTbody tr        { cursor:pointer; }
    #dxSpotsTbody tr:hover td { background:#333; }
    #dxSpotsDialog th[data-sort]:hover { background:#444; }
</style>
<dialog id="dxSpotsDialog" style="border:1px solid #555; border-radius:8px; background:#222; color:#eee; padding:0; min-width:720px; max-width:95vw;" aria-labelledby="dxSpotsTitle">
    <div class="dxs-header d-flex align-items-center justify-content-between px-3 py-2" style="border-bottom:1px solid #444; cursor:move;">
        <strong id="dxSpotsTitle">DX Spots</strong>
        <div class="d-flex align-items-center gap-3">
            <small id="dxSpotsCount" class="text-muted">0 shown / 0 total</small>
            <div class="form-check form-switch mb-0" style="cursor:default;">
                <input class="form-check-input" type="checkbox" id="dxSpotsAllBandsChk">
                <label class="form-check-label small" for="dxSpotsAllBandsChk">All bands</label>
            </div>
            <button class="btn btn-sm iwc-dialog-close"
                    onclick="window.dxSpotsPanel && window.dxSpotsPanel.close()"
                    aria-label="Close DX spots panel">✕</button>
        </div>
    </div>
    <div class="p-2" style="max-height:60vh; overflow-y:auto;">
        <table class="table table-sm table-dark table-hover mb-0" style="font-size:0.85rem;">
            <thead style="position:sticky; top:0; background:#222; z-index:1;">
                <tr>
                    <th data-sort="callsign" style="cursor:pointer;">Callsign</th>
                    <th data-sort="freq"     style="cursor:pointer;">Freq kHz</th>
                    <th data-sort="mode"     style="cursor:pointer;">Mode</th>
                    <th data-sort="time"     style="cursor:pointer;">Time UTC</th>
                    <th data-sort="age"      style="cursor:pointer;">Age</th>
                    <th data-sort="spotter"  style="cursor:pointer;">Spotter</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody id="dxSpotsTbody"></tbody>
        </table>
        <div id="dxSpotsEmpty" class="text-muted small p-3" style="display:none;">
            No spots on this band. Configure DX cluster in Settings (§6.6) if not already done,
            or tick <strong>All bands</strong> above to see spots from elsewhere.
        </div>
    </div>
</dialog>

<!-- DX Watch alert toast container — populated by site.js when a watched spot arrives.
     Position is user-draggable; saved in localStorage as dxAlertPos. Defaults to
     bottom-right of the viewport on first run. -->
<div id="dxAlertToastHost" aria-live="assertive" aria-atomic="true"
     style="position:fixed; right:16px; bottom:16px; z-index:9999;
            display:flex; flex-direction:column; gap:8px;"></div>

<!-- TX timeout warning banner — shown when transmit has been on longer than the threshold -->
<div id="txTimeoutBanner"
     role="alert"
     aria-live="assertive"
     style="display:none; position:fixed; top:0; left:0; right:0; z-index:10000;
            background:#a02020; color:#fff; padding:10px 16px;
            font-family:sans-serif; font-weight:bold; font-size:1.05em;
            box-shadow:0 2px 8px rgba(0,0,0,0.5);">
    <span id="txTimeoutBannerText">TX has been on for too long</span>
    <button type="button" id="txTimeoutDismissBtn"
            style="float:right; background:#fff; color:#a02020; border:none;
                   padding:2px 10px; border-radius:4px; font-weight:bold; cursor:pointer;"
            aria-label="Dismiss TX timeout warning">Dismiss</button>
    <button type="button" id="txTimeoutSetBtn"
            style="float:right; background:#7a1818; color:#fff; border:1px solid #fff;
                   padding:2px 10px; border-radius:4px; margin-right:8px; cursor:pointer;"
            aria-label="Change TX timeout threshold">Change timeout…</button>
</div>

@section Scripts {
    <!-- Cache-busted JS reference, placed BEFORE your inline script if you use window.radioControl, etc. -->
    <script>window.bandPlan = '@Model.BandPlan';</script>
    <script>
        window.iwcTxToggleKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TxToggleKey));
        window.iwcVoiceNudgeStepHzA = @Model.VoiceNudgeStepHzA;
        window.iwcVoiceNudgeStepHzB = @Model.VoiceNudgeStepHzB;
    </script>
    <script type="module">
        import { MeterPanel }           from "/js/guages/meter-panel.js?v=1";
        import { SMeterHistoryPanel }   from "/js/guages/smeter-history-panel.js?v=1";
        import { Ic7300Meters }         from "/js/orchestrators/Ic7300Meters.js?v=1";
        import { SdrSpectrumPipeline }  from "/js/sdr/sdr-spectrum-pipeline.js?v=1";
        import { SpectrumPanel }        from "/js/sdr/spectrum-panel.js?v=6";
        import { BAND_PLANS, BAND_EDGES, getSegments, segmentForHz, nearestBandForHz, loadBandPlanFromServer } from "/js/ui/band-plan.js?v=8";
        import { loadLabels }           from "/js/ui/a11y-labels.js?v=1";
        import { initFreqKeyboard }     from "/js/ui/freq-keyboard.js?v=14";
        import { initMemoriesPanel }   from "/js/ui/memories.js?v=10";
        import { DxSpotsPanel }         from "/js/ui/dx-spots-panel.js?v=1";
        window.bandPlanData = BAND_PLANS;
        window.getBandSegments = getSegments;
        window.getBandSegmentForHz = segmentForHz;
        // site.js is a classic script, not a module, so it reaches the band
        // tables through window. Used to mark the band button red when the
        // radio is out of the operator's regional allocation.
        //
        // Resolves BAND_EDGES on every call rather than capturing the array:
        // loadBandPlanFromServer() replaces the per-region arrays wholesale
        // when it overlays bandplan.default.json, so anything holding a
        // reference would keep answering from the pre-overlay table.
        window.nearestBandForHz = hz =>
            nearestBandForHz(hz, BAND_EDGES['@Model.BandPlan'] || BAND_EDGES.Region1);
        // loadLabels rewrites every data-a11y-key title from labels.json, which
        // wipes the "out of band" suffix on a band button. Put it back after.
        const reapplyLabels = () => loadLabels().finally(() => {
            if (typeof window.refreshBandOutOfBand === 'function') window.refreshBandOutOfBand();
        });
        reapplyLabels();
        window.addEventListener('focus', reapplyLabels);
        document.addEventListener('DOMContentLoaded', function () {
            initFreqKeyboard();
            initMemoriesPanel();

            // ── UTC clock in the top bar ──────────────────────────────────────
            const utcClockEl = document.getElementById('utcClock');
            if (utcClockEl) {
                const pad2 = n => String(n).padStart(2, '0');
                const tick = () => {
                    const d = new Date();
                    utcClockEl.textContent =
                        `${pad2(d.getUTCHours())}:${pad2(d.getUTCMinutes())}:${pad2(d.getUTCSeconds())}Z`;
                };
                tick();
                setInterval(tick, 1000);
            }
            window.meterPanel = new MeterPanel({
                // v2.3.9 dropped SMeterB to a single shared gauge; v2.4.0
                // restored it as a real VFO A / VFO B pair on dual-receiver
                // radios (FTdx101MP/D each have an independently calibrated
                // S-meter, SM0;/SM1;). smeterB's canvas doesn't exist on
                // single-receiver radios, so MeterPanel._createGauges skips
                // it automatically (config entries for missing canvases are
                // no-ops) — no isSingleReceiver check needed here.
                smeter:      { type: 'smeter', canvasId: 'sMeterCanvas' },
                smeterB:     { type: 'smeter', canvasId: 'sMeterCanvasB', gaugeTitleId: 'sMeterValueB' },
                power:       { canvasId: 'powerMeterCanvas' },
                swr:         { canvasId: 'swrMeterCanvas' },
                compression: { canvasId: 'compressionMeterCanvas' },
                alc:         { canvasId: 'alcMeterCanvas' },
                idd:         { canvasId: 'iddMeterCanvas' },
                vdd:         { canvasId: 'vddMeterCanvas' }
            });
            window.ic7300Meters = new Ic7300Meters(window.meterPanel, window.calibrationEngine);

            // ── S-meter history strips ───────────────────────────────────────
            // Hidden by default. Toggle via the "S-hist" button in the top
            // toolbar; visibility persists in localStorage so the choice
            // survives page reloads. Both A and B strips (when B exists)
            // share the one toggle — independent per-VFO toggles can be
            // added later if wanted, but one button is the smaller change.
            window.sMeterHistory  = new SMeterHistoryPanel('sMeterHistoryCanvas');
            window.sMeterHistoryB = new SMeterHistoryPanel('sMeterHistoryCanvasB');
            (function () {
                const btn  = document.getElementById('sMeterHistoryToggleBtn');
                const con  = document.getElementById('sMeterHistoryContainer');
                const conB = document.getElementById('sMeterHistoryContainerB');
                if (!btn || !con) return;

                const KEY = 'iwc.sMeterHistoryVisible';
                const apply = (visible) => {
                    con.style.display = visible ? '' : 'none';
                    if (conB) conB.style.display = visible ? '' : 'none';
                    btn.classList.toggle('active', visible);
                    btn.setAttribute('aria-pressed', visible ? 'true' : 'false');
                };
                let visible = false;
                try { visible = localStorage.getItem(KEY) === '1'; } catch {}
                apply(visible);

                btn.addEventListener('click', () => {
                    visible = !visible;
                    try { localStorage.setItem(KEY, visible ? '1' : '0'); } catch {}
                    apply(visible);
                });
            })();

            // ── Spectrum display (dual-VFO, v2.3.0+) ─────────────────────────
            // One SpectrumPanel per VFO. SdrSpectrumPipeline routes by sdrId.
            // SdrManager will only spawn worker(s) for VFO(s) actually configured.
            const spectrumPanelA = new SpectrumPanel(
                'spectrumCanvasA',
                'spectrumContainerA',
                @Model.RadioState.FrequencyA,
                'A'
            );
            const spectrumPanelB = new SpectrumPanel(
                'spectrumCanvasB',
                'spectrumContainerB',
                @Model.RadioState.FrequencyB,
                'B'
            );

            // Region-specific band plan for FT8/CW/SSB markers on both panels.
            const _iwcRegion = '@Model.BandPlan';
            if (BAND_PLANS[_iwcRegion]) {
                spectrumPanelA.setBandPlan(BAND_PLANS[_iwcRegion]);
                spectrumPanelB.setBandPlan(BAND_PLANS[_iwcRegion]);
            }
            // Region-specific band edges (red dashed guard rails). Falls back
            // to the class-static worldwide envelope inside SpectrumPanel if
            // the region key isn't found.
            // First, overlay any updates from /bandplan.default.json so users
            // who've dropped in a corrected band plan see them on next reload.
            // This is fire-and-forget: if the fetch succeeds in time we apply
            // the result; if not, the panels keep the hardcoded defaults and
            // we re-apply once the fetch resolves. Net effect: hardcoded
            // defaults always work; updated JSON applies as soon as it loads.
            loadBandPlanFromServer().then(loaded => {
                if (loaded && BAND_PLANS[_iwcRegion]) {
                    spectrumPanelA.setBandPlan(BAND_PLANS[_iwcRegion]);
                    spectrumPanelB.setBandPlan(BAND_PLANS[_iwcRegion]);
                }
                if (loaded && BAND_EDGES[_iwcRegion]) {
                    spectrumPanelA.setBandEdges(BAND_EDGES[_iwcRegion]);
                    spectrumPanelB.setBandEdges(BAND_EDGES[_iwcRegion]);
                }
            });
            if (BAND_EDGES[_iwcRegion]) {
                spectrumPanelA.setBandEdges(BAND_EDGES[_iwcRegion]);
                spectrumPanelB.setBandEdges(BAND_EDGES[_iwcRegion]);
            }

            const spectrumPipeline = new SdrSpectrumPipeline();

            // Per-VFO spectrum routing. Also keep the span buttons in step with
            // the span the radio reports (data.spanHz is the full width; the
            // buttons carry the ± half-width), so changing SPAN on the radio's
            // own front panel lights the matching button here. Only touch the
            // DOM when the span actually changes — frames arrive ~30×/s.
            const _lastSpanHz = { A: 0, B: 0 };
            function syncSpanButtons(vfo, data) {
                const span = data && data.spanHz;
                if (!span || span === _lastSpanHz[vfo]) return;
                _lastSpanHz[vfo] = span;
                if (window.__markActiveSpan) window.__markActiveSpan(vfo, Math.round(span / 2));
            }
            // What finally clears the start-up overlay: an SdrStatus of
            // "streaming", NOT the first SpectrumUpdate. Frames arrive well
            // before the panel is visible — #spectrumContainer starts at
            // display:none and is only un-hidden by updateContainerVisibility,
            // which runs off SdrStatus, and CivRadioController only announces
            // that every 30th sweep (_scopeBroadcasts % 30). A client that
            // connects mid-stream therefore gets bins for up to ~2 s before the
            // card appears, so gating on the first frame cleared the overlay
            // while the operator was still waiting for the spectrum. Called
            // from the onStatusChange handlers below; markInitStage ignores
            // repeats, so the 30-sweep re-announce costs nothing.
            const markSpectrumReady = () => window.markInitStage && window.markInitStage('spectrum');

            // Scope switched off in an earlier page view: no sweep is coming, so
            // release the overlay's spectrum stage now instead of making the
            // operator wait out the timeout on every load.
            const SCOPE_STATE_KEY = 'iwc.scopeEnabled';
            let _scopeLastState = null;
            try { _scopeLastState = localStorage.getItem(SCOPE_STATE_KEY); } catch { /* private mode */ }
            if (_scopeLastState === 'off') markSpectrumReady();

            spectrumPipeline.onSpectrumUpdate('A', data => { spectrumPanelA.update(data); syncSpanButtons('A', data); });
            spectrumPipeline.onSpectrumUpdate('B', data => { spectrumPanelB.update(data); syncSpanButtons('B', data); });

            // Scope on/off switch — turns the radio's spectrum scope + waveform
            // output on or off (CI-V 27 10 / 27 11). Off stops the trace streaming.
            const scopeSwitch = document.getElementById('scopeEnableSwitch');
            if (scopeSwitch) {
                // The switch is a request, not a readback — there's no "is the
                // scope on?" poll. Restore the operator's last choice so a reload
                // doesn't show it on while the scope is off; markStreaming() below
                // corrects it the moment a sweep proves otherwise (the
                // controller's _operatorScopeOff doesn't survive an app restart).
                if (_scopeLastState === 'off') scopeSwitch.checked = false;

                scopeSwitch.addEventListener('change', () => {
                    const state = scopeSwitch.checked ? 'on' : 'off';
                    // Remembered only so the start-up overlay doesn't wait for a
                    // sweep that isn't coming — the controller honours a manual
                    // scope-off across reconnects (_operatorScopeOff), so after
                    // turning it off every page load would otherwise sit on the
                    // spinner until the timeout. If this flag is stale (the app
                    // restarted and the scope really is on) the worst case is
                    // that the overlay clears at radio-ready, as it used to.
                    try { localStorage.setItem(SCOPE_STATE_KEY, state); } catch { /* private mode */ }
                    fetch(`/api/cat/scope/${state}`, { method: 'POST' })
                        .catch(() => { /* ignore network errors */ });
                });
            }

            // Per-VFO status routing — drives the panel state + small badge in the header.
            function setStatusBadge(vfo, status) {
                const badge = document.getElementById('spectrumStatusBadge' + vfo);
                if (!badge) return;
                // Wording is scope wording, not SDR wording — the trace comes
                // from the radio's own band scope over CI-V. 'unconfigured' is
                // the client-side starting state: no sweep has arrived yet, so
                // either the scope is switched off or the radio isn't up.
                const labels = {
                    unconfigured: ['secondary', 'Scope off'],
                    connecting:   ['warning',   'Connecting…'],
                    streaming:    ['success',   'Live'],
                    disconnected: ['danger',    'Disconnected'],
                    outofrange:   ['warning',   'Off-screen'],
                };
                const [colour, text] = labels[status] ?? ['secondary', status];
                badge.className = `badge bg-${colour} small`;
                badge.textContent = text;
            }
            // Pseudo-dual receiver (Phase 5): when on, the "watch" panel B is
            // meaningful even on the single-receiver IC-7300 (the scope is
            // time-shared to feed it). Server-rendered from settings.
            const _pseudoDual = @(Model.PseudoDualReceiverEnabled ? "true" : "false");

            // Track per-VFO configured/streaming state so we can show or hide the
            // outer spectrumContainer and the Mono/Multi toggle as appropriate.
            const sdrState = { A: 'unconfigured', B: 'unconfigured' };

            // Whether the radio itself is connected, fed from the same place the
            // connect button's colour is (_applyConnectBtnState below), which in
            // turn is driven by both the SignalR state stream and the initial
            // /api/cat/status fetch.
            //
            // GitHub #1: panel A used to be revealed *only* by an SdrStatus, and
            // the only thing that emitted one was a completed sweep. A radio whose
            // scope wasn't streaming therefore produced no spectrum card at all —
            // and the Scope on/off switch is inside that card, so there was no way
            // to switch it on. A connected radio always has a scope, so connection
            // is what the card should hang on; the panel overlay explains the rest.
            let _radioConnected = false;
            window.__spectrumSetConnected = (connected) => {
                connected = !!connected;
                if (_radioConnected === connected) return;
                _radioConnected = connected;
                updateContainerVisibility();
                // Revealed with no server status yet: paint "waiting" rather than a
                // bare black canvas. The controller announces the real state within
                // a few seconds, streaming or not, and overwrites this.
                if (connected && sdrState.A === 'unconfigured') {
                    spectrumPanelA.setStatus('connecting');
                    setStatusBadge('A', 'connecting');
                }
            };

            function updateContainerVisibility() {
                const aConfigured = sdrState.A !== 'unconfigured' || _radioConnected;
                let bConfigured = sdrState.B !== 'unconfigured';

                // A single-receiver radio has only ONE scope, so the second
                // spectrum panel is never meaningful on its own account —
                // pseudo-dual is what fills it instead. Force B
                // as unconfigured here so the Mono/Multi toggle and the
                // spectrum-B panel are both hidden, leaving just one
                // spectrum + a show/hide control (#34 follow-up,
                // 2026-06-13).
                // On single-receiver radios the second panel is normally
                // meaningless — force it off. EXCEPT when pseudo-dual receiver
                // is enabled: then the IC-7300's single scope is time-shared to
                // feed a watch panel, so B stays gated on its own stream state.
                const vfoRow = document.getElementById('vfoRow');
                if (vfoRow?.dataset.singleReceiver === 'true' && !_pseudoDual) {
                    bConfigured = false;
                }

                // Outer container visible if either VFO has an SDR configured.
                document.getElementById('spectrumContainer').style.display =
                    (aConfigured || bConfigured) ? '' : 'none';

                // Mono/Multi toggle only meaningful when BOTH are configured.
                // Note: spectrumModeToggle has Bootstrap's d-flex class which
                // applies display: flex !important — so plain
                // `style.display = 'none'` is silently ignored. Use
                // setProperty with priority='important' to actually win.
                // For the show case, just remove the inline override and
                // let d-flex take over.
                const toggleEl = document.getElementById('spectrumModeToggle');
                if (toggleEl) {
                    if (aConfigured && bConfigured) {
                        toggleEl.style.removeProperty('display');
                    } else {
                        toggleEl.style.setProperty('display', 'none', 'important');
                    }
                }

                // If only one side is configured, force that side visible regardless of mode.
                if (!bConfigured) {
                    document.getElementById('spectrumContainerB').style.display = 'none';
                    document.getElementById('spectrumContainerA').style.display = aConfigured ? '' : 'none';
                } else if (!aConfigured) {
                    document.getElementById('spectrumContainerA').style.display = 'none';
                    document.getElementById('spectrumContainerB').style.display = '';
                } else {
                    // Both configured — honour the active mode.
                    applyMode(currentMode);
                }
            }

            // Mono/Multi toggle — persisted in localStorage so the user's
            // last-used layout sticks across page reloads. Default Multi (both).
            const MODE_STORAGE_KEY = 'iwc.spectrumMode';
            let currentMode = localStorage.getItem(MODE_STORAGE_KEY) || 'Multi';
            function applyMode(mode) {
                currentMode = mode;
                localStorage.setItem(MODE_STORAGE_KEY, mode);
                const showA = (mode === 'A' || mode === 'Multi');
                const showB = (mode === 'B' || mode === 'Multi');
                document.getElementById('spectrumContainerA').style.display = showA ? '' : 'none';
                document.getElementById('spectrumContainerB').style.display = showB ? '' : 'none';
                document.querySelectorAll('.spectrum-mode-btn').forEach(b => {
                    b.classList.toggle('active', b.dataset.mode === mode);
                });
                // Trigger canvas resize since the layout just changed.
                window.dispatchEvent(new Event('resize'));
            }
            document.querySelectorAll('.spectrum-mode-btn').forEach(b => {
                b.addEventListener('click', () => applyMode(b.dataset.mode));
            });

            // Stacked / Side-by-side layout toggle — persisted in localStorage
            // so the user's preference sticks across reloads. Default stacked
            // (matches the v2.3.0 initial layout).
            const LAYOUT_STORAGE_KEY = 'iwc.spectrumLayout';
            let currentLayout = localStorage.getItem(LAYOUT_STORAGE_KEY) || 'stacked';
            function applyLayout(layout) {
                currentLayout = layout;
                localStorage.setItem(LAYOUT_STORAGE_KEY, layout);
                const panels = document.getElementById('spectrumPanels');
                if (!panels) return;
                if (layout === 'side') {
                    panels.classList.remove('flex-column');
                    panels.classList.add('flex-row');
                } else {
                    panels.classList.remove('flex-row');
                    panels.classList.add('flex-column');
                }
                document.querySelectorAll('.spectrum-layout-btn').forEach(b => {
                    b.classList.toggle('active', b.dataset.layout === layout);
                });
                // Canvas dimensions changed — let ResizeObserver pick up the new width.
                window.dispatchEvent(new Event('resize'));
            }
            document.querySelectorAll('.spectrum-layout-btn').forEach(b => {
                b.addEventListener('click', () => applyLayout(b.dataset.layout));
            });
            // Apply the persisted layout immediately so the page renders in the
            // user's chosen layout from the first frame.
            applyLayout(currentLayout);

            // Seed the connection-driven visibility from what the connect button
            // already knows. The /api/cat/status fetch that sets it runs in the
            // module body (before DOMContentLoaded) but resolves asynchronously —
            // whichever of the two lands second wins, and both routes end here.
            window.__spectrumSetConnected(_catConnected);

            // A sweep is proof the scope is on. The remembered state can be stale
            // (the app restarted, and with it the controller's non-persisted
            // _operatorScopeOff), which would leave the switch showing "off" over a
            // live trace — and the next click would then turn the scope ON by
            // sending "off". Correct both the switch and the remembered value.
            const markScopeStreaming = () => {
                markSpectrumReady();
                if (scopeSwitch && !scopeSwitch.checked) scopeSwitch.checked = true;
                if (_scopeLastState !== 'on') {
                    _scopeLastState = 'on';
                    try { localStorage.setItem(SCOPE_STATE_KEY, 'on'); } catch { /* private mode */ }
                }
            };

            spectrumPipeline.onStatusChange('A', status => {
                sdrState.A = status;
                spectrumPanelA.setStatus(status);
                setStatusBadge('A', status);
                updateContainerVisibility();
                if (status === 'streaming') markScopeStreaming();
            });
            spectrumPipeline.onStatusChange('B', status => {
                sdrState.B = status;
                spectrumPanelB.setStatus(status);
                setStatusBadge('B', status);
                updateContainerVisibility();
                if (status === 'streaming') markScopeStreaming();
            });
            spectrumPipeline.onError('A', detail => spectrumPanelA.setError(detail));
            spectrumPipeline.onError('B', detail => spectrumPanelB.setError(detail));

            // Stand up the DX Spots list panel BEFORE wiring the pipeline so its
            // handlers can dispatch to it. It works whether or not the SDR is
            // configured — relies only on the DxSpot/FrequencyA event stream.
            window.dxSpotsPanel = new DxSpotsPanel();
            window.dxSpotsPanel.init();
            window.dxSpotsPanel.setVfoFrequency(@Model.RadioState.FrequencyA);

            spectrumPipeline.onFrequencyA(hz => {
                spectrumPanelA.setVfoFrequency(hz);
                window.dxSpotsPanel.setVfoFrequency(hz);
            });
            spectrumPipeline.onFrequencyB(hz => {
                spectrumPanelB.setVfoFrequency(hz);
            });

            // DX cluster spots — incoming SignalR pushes feed BOTH spectrum
            // overlays (when visible) plus the DX Spots list (always available).
            spectrumPipeline.onDxSpot(spot => {
                spectrumPanelA.addSpot(spot);
                spectrumPanelB.addSpot(spot);
                window.dxSpotsPanel.addSpot(spot);
            });
            spectrumPipeline.onDxClusterStatus(s => {
                spectrumPanelA.setDxStatus(s?.status, s?.detail);
                spectrumPanelB.setDxStatus(s?.status, s?.detail);
            });
            spectrumPipeline.onDxAlert(spot => { if (window.handleDxAlert) window.handleDxAlert(spot); });

            // Repaint when "Show only watched callsigns" changes.
            window.addEventListener('dxWatchFilterChanged', () => {
                try { spectrumPanelA.redraw(); } catch {}
                try { spectrumPanelB.redraw(); } catch {}
                try { window.dxSpotsPanel && window.dxSpotsPanel.redraw(); } catch {}
            });
            fetch('/api/dxcluster/spots')
                .then(r => r.ok ? r.json() : [])
                .then(arr => {
                    spectrumPanelA.setSpots(arr);
                    spectrumPanelB.setSpots(arr);
                    window.dxSpotsPanel.setSpots(arr);
                })
                .catch(() => { /* feature off or backend not ready — ignore */ });
            fetch('/api/dxcluster/status')
                .then(r => r.ok ? r.json() : null)
                .then(s => {
                    if (s) {
                        spectrumPanelA.setDxStatus(s.status, s.detail);
                        spectrumPanelB.setDxStatus(s.status, s.detail);
                    }
                })
                .catch(() => { /* ignore */ });

            spectrumPipeline.connect();
            // Expose both panels globally for cross-module access (overlay redraws,
            // band-plan reloads, etc.). window.spectrumPanel kept pointing at the
            // A panel as a backward-compatible alias for code that may still expect
            // a single-panel handle.
            window.spectrumPanelA = spectrumPanelA;
            window.spectrumPanelB = spectrumPanelB;
            window.spectrumPanel  = spectrumPanelA;

            // Filter-scope panels, Contour and IF-Width/Shift controls were
            // removed for the IC-7300 (direct-sampling SDR — no roofing filters,
            // no Yaesu-style IF width/shift, no Contour). See the clone-split plan.
            window._radioModel = '@Model.RadioModel';

            // Hold button — toggles whether the panel updates from incoming
            // SDR frames. While held the spectrum + waterfall freeze at the
            // last received frame so the operator can study a fleeting
            // signal. Click again to resume. State is per-VFO.
            document.querySelectorAll('.spectrum-hold-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const vfo = btn.dataset.vfo;
                    const panel = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                    if (!panel) return;
                    const nowHeld = !panel.isHeld();
                    panel.setHold(nowHeld);
                    // Visual feedback: button goes 'active' (filled) when held.
                    btn.classList.toggle('active', nowHeld);
                    btn.classList.toggle('btn-warning', nowHeld);
                    btn.classList.toggle('btn-outline-light', !nowHeld);
                    // Reflect in the status badge so the change is obvious
                    // even when looking at the panel, not just the toolbar.
                    const badge = document.getElementById('spectrumStatusBadge' + vfo);
                    if (badge && nowHeld) {
                        badge.className = 'badge bg-warning small';
                        badge.textContent = 'Hold';
                    } else if (badge && !nowHeld) {
                        // Falls back to whatever the next status update sets;
                        // until then show "Live" if we were streaming.
                        badge.className = 'badge bg-success small';
                        badge.textContent = 'Live';
                    }
                });
            });

            // ── Pseudo-dual "Listen" button + "Listening" badge (Phase 5) ────
            // Each panel gets a Listen button (route audio to that VFO) and a
            // "Listening" badge (this VFO currently has the audio). Only active
            // when pseudo-dual is on — otherwise both stay hidden and this is a
            // plain single-panel layout. The badge follows the authoritative
            // ActiveVfo state pushed from the radio via site.js's hook.
            (function wirePseudoDualAudio() {
                if (!_pseudoDual) return; // buttons/badges stay display:none
                const listenBtns = Array.from(document.querySelectorAll('.spectrum-listen-btn'));
                const audioBadges = Array.from(document.querySelectorAll('.spectrum-audio-badge'));
                const idxOf = el => (el.dataset.vfo === 'B' ? 1 : 0);

                // 0 = A, 1 = B. Seed from the server-rendered active VFO.
                let audioVfo = @Model.RadioState.ActiveVfo;

                function refresh() {
                    // Show the Listen button on the panel you are NOT hearing;
                    // show the "Listening" badge on the one you are.
                    listenBtns.forEach(btn => {
                        btn.style.display = (idxOf(btn) === audioVfo) ? 'none' : '';
                    });
                    audioBadges.forEach(b => {
                        b.style.display = (idxOf(b) === audioVfo) ? '' : 'none';
                    });
                }

                listenBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const vfo = (idxOf(btn) === 1) ? 'b' : 'a';
                        // Optimistic move; the ActiveVfo SignalR echo corrects it
                        // if the radio disagrees. Self-contained fetch so this
                        // doesn't depend on site.js internals.
                        audioVfo = idxOf(btn);
                        refresh();
                        fetch(`/api/cat/active-vfo/${vfo}`, { method: 'POST' }).catch(() => {});
                    });
                });

                // Authoritative updates from the radio (see site.js ActiveVfo).
                window.onActiveVfoChanged = idx => { audioVfo = idx; refresh(); };

                refresh();
            })();

            // Spectrum DSP sliders — Low (dB floor) / High (dB ceiling). On the
            // CI-V scope these are purely client-side: the radio streams a fixed
            // 0–160 amplitude trace, so Low/High only reposition the canvas
            // colour window via panel.setDbRange(high, low). (The old pre-dB
            // "Gain" slider is gone — it drove the SDR worker, which the CI-V
            // scope path doesn't use.) Initial values come from Razor settings.
            // Debounced server-side persistence of the four spectrum display
            // sliders (Low/High/Speed/Bright). Merges pending fields per VFO and
            // POSTs to /api/cat/spectrumdisplay/{vfo} after a quiet period, so
            // dragging a slider doesn't spam the settings file. This is what makes
            // the values survive across sessions AND browsers (superseding the old
            // localStorage-only Speed/Bright); the panel's localStorage cache is
            // still updated so a same-browser reload is instant before the server
            // round-trip.
            const _specSaveTimers  = {};
            const _specSavePending = { A: {}, B: {} };
            function persistSpectrumDisplay(vfo, fields) {
                Object.assign(_specSavePending[vfo], fields);
                clearTimeout(_specSaveTimers[vfo]);
                _specSaveTimers[vfo] = setTimeout(() => {
                    const body = _specSavePending[vfo];
                    _specSavePending[vfo] = {};
                    fetch(`/api/cat/spectrumdisplay/${vfo}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    }).catch(() => {});
                }, 500);
            }

            // Vertical scale is a single "Range" control now — the panel tracks the
            // noise floor automatically and pins it near the bottom of the scope, so
            // the only thing left to choose is how much dB of headroom sits above it
            // (smaller = taller peaks / more gain). This kills the old Floor/Range
            // coupling where widening the span slid the noise off the bottom. Storage
            // is still {low, high}; only (high − low) = Range is meaningful now, so we
            // persist against a fixed nominal base and let Range round-trip.
            (function wireDspSliders() {
                const PERSIST_BASE = -110;   // arbitrary; auto-floor ignores absolutes

                ['A', 'B'].forEach(vfo => {
                    const rangeSlider = document.querySelector(`.spectrum-range-slider[data-vfo="${vfo}"]`);
                    const rangeLabel  = document.querySelector(`.spectrum-range-label[data-vfo="${vfo}"]`);
                    if (!rangeSlider) return;   // VFO B hidden when no SDR

                    const panel = () => (vfo === 'B' ? spectrumPanelB : spectrumPanelA);

                    function apply() {
                        const range = parseFloat(rangeSlider.value);
                        if (rangeLabel) rangeLabel.textContent = `${range} dB`;
                        const p = panel();
                        if (p) p.setSpectrumRange(range);
                        persistSpectrumDisplay(vfo, { low: PERSIST_BASE, high: PERSIST_BASE + range });
                    }

                    // Sync canvas to the server-rendered initial Range value.
                    const p = panel();
                    if (p) p.setSpectrumRange(parseFloat(rangeSlider.value));

                    rangeSlider.addEventListener('input', apply);
                });
            })();

            // Waterfall scroll speed — changes how often SpectrumPanel advances
            // the waterfall by one row per incoming FFT frame. The initial value
            // is server-rendered (data-server-speed = divisor) so it survives
            // across browsers/devices; it's also written back to the panel's
            // localStorage cache so a same-browser reload is instant. The slider
            // drags across an *index* into SpectrumPanel.WATERFALL_SPEEDS
            // (1,2,4,...,128) rather than the divisor itself, since the divisors
            // aren't evenly spaced.
            ['A', 'B'].forEach(vfo => {
                const slider = document.querySelector(`.spectrum-speed-slider[data-vfo="${vfo}"]`);
                const label  = document.querySelector(`.spectrum-speed-label[data-vfo="${vfo}"]`);
                const panel  = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                if (!slider || !label || !panel) return;

                const speeds = SpectrumPanel.WATERFALL_SPEEDS;
                const formatSpeed = (d) => d === 1 ? 'Full' : `1/${d}`;

                const serverDivisor = parseInt(slider.dataset.serverSpeed, 10);
                const initialIndex  = Math.max(0, speeds.indexOf(
                    Number.isFinite(serverDivisor) ? serverDivisor : panel.getWaterfallSpeed()));
                slider.value = String(initialIndex);
                label.textContent = formatSpeed(speeds[initialIndex]);
                panel.setWaterfallSpeed(speeds[initialIndex]);   // sync panel + localStorage to server value

                slider.addEventListener('input', () => {
                    const divisor = speeds[parseInt(slider.value, 10)];
                    label.textContent = formatSpeed(divisor);
                    panel.setWaterfallSpeed(divisor);
                    persistSpectrumDisplay(vfo, { speed: divisor });
                });
            });

            // Waterfall brightness — adds a dB lift to the waterfall's colour
            // mapping only (the spectrum trace is left alone). 0 = "Off". Initial
            // value is server-rendered (data-server-bright) so it survives across
            // browsers/devices; also mirrored into the panel's localStorage cache.
            ['A', 'B'].forEach(vfo => {
                const slider = document.querySelector(`.spectrum-bright-slider[data-vfo="${vfo}"]`);
                const label  = document.querySelector(`.spectrum-bright-label[data-vfo="${vfo}"]`);
                const panel  = vfo === 'B' ? spectrumPanelB : spectrumPanelA;
                if (!slider || !label || !panel) return;

                const formatBright = (db) => db <= 0 ? 'Off' : `+${db}`;

                const serverBright = parseInt(slider.dataset.serverBright, 10);
                const initial = Number.isFinite(serverBright) ? serverBright : panel.getWaterfallBrightness();
                slider.value = String(initial);
                label.textContent = formatBright(initial);
                panel.setWaterfallBrightness(initial);   // sync panel + localStorage to server value

                slider.addEventListener('input', () => {
                    const db = parseInt(slider.value, 10);
                    label.textContent = formatBright(db);
                    panel.setWaterfallBrightness(db);
                    persistSpectrumDisplay(vfo, { bright: db });
                });
            });

            // Span selector — set the IC-7300's scope span (CI-V 27 15). data-hz
            // is the ± half-width the radio wants (2500…500000); the displayed
            // full width is twice it. The active button is also synced from the
            // span reported in each incoming SpectrumUpdate (see below), so it
            // follows spans changed on the radio's own front panel too.
            function markActiveSpan(vfo, hz) {
                document.querySelectorAll(`.span-btn[data-vfo="${vfo}"]`).forEach(b => {
                    b.classList.toggle('active', parseInt(b.dataset.hz, 10) === hz);
                });
            }
            // How the watch panel's (VFO B) span buttons behave — the radio has
            // ONE scope, so B is a crop of A's single sweep:
            //   ZoomIn — B narrows its crop in software (POST watchspan); A untouched.
            //   Shared — B drives the one physical span like A (POST scopespan);
            //            both panels' highlights follow it.
            //   Hidden — B's span buttons are removed (below); only A controls span.
            const _watchSpanMode = '@Model.PseudoDualWatchSpanMode';

            async function postSpan(url, hz) {
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(hz)
                    });
                    return res.ok;
                } catch { return false; /* network error — ignore */ }
            }

            document.querySelectorAll('.span-btn').forEach(btn => {
                btn.addEventListener('click', async () => {
                    const hz  = parseInt(btn.dataset.hz, 10);
                    const vfo = btn.dataset.vfo || 'A';

                    // VFO B in ZoomIn mode: crop-only, never touches the scope or A.
                    if (vfo === 'B' && _watchSpanMode === 'ZoomIn') {
                        if (await postSpan('/api/cat/watchspan/B', hz)) markActiveSpan('B', hz);
                        return;
                    }

                    // A, or B in Shared mode: drive the one physical span. In Shared
                    // mode light both panels' buttons so the single scope is obvious.
                    if (await postSpan(`/api/cat/scopespan/${vfo}`, hz)) {
                        markActiveSpan(vfo, hz);
                        if (vfo === 'B' && _watchSpanMode === 'Shared') markActiveSpan('A', hz);
                        if (vfo === 'A' && _watchSpanMode === 'Shared') markActiveSpan('B', hz);
                    }
                });
            });

            // Hidden mode: drop VFO B's span selector entirely.
            if (_watchSpanMode === 'Hidden') {
                document.querySelectorAll('.span-btn[data-vfo="B"]').forEach(b => {
                    const group = b.closest('.btn-group');
                    if (group) group.style.display = 'none';
                });
            }
            window.__markActiveSpan = markActiveSpan;
        });
