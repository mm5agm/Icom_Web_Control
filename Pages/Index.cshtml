@page
@model Icom_Web_Control.Pages.IndexModel
@{
    ViewData["Title"]     = "Icom Web Control";
    ViewData["BodyRole"]  = "application";
    ViewData["BodyLabel"] = "Icom radio control panel";
    // The IC-7300's CI-V mode set. Data variants (USB-D/LSB-D/FM-D) map to
    // DATA-U/DATA-L/DATA-FM via command 1A 06; the Yaesu-only strings
    // (FM-N, AM-N, DATA-FM-N, PSK) have no IC-7300 equivalent and are dropped.
    var allModes = new[] {
        "LSB", "USB", "CW-U", "CW-L", "FM", "AM", "RTTY-L", "RTTY-U",
        "DATA-L", "DATA-U", "DATA-FM"
    };
    // Display label shown in the dropdown — value stays as the CAT mode string.
    string ModeLabel(string m) => m;

    // The IC-7300 has one receiver: VFO A and VFO B are frequency-and-mode
    // slots the single receiver is steered through, and CAT always addresses
    // whichever is active — see docs/decisions/0003-single-vs-dual-receiver-ui.md.
    // The home page greys out the inactive VFO panel to reflect that editing it
    // would silently swap the radio's active VFO. The lookup stays behind
    // RadioCapabilities rather than being hard-coded true, so adding a model
    // that genuinely has two receivers is a one-line change there.
    bool isSingleReceiver   = Icom_Web_Control.Services.RadioCapabilities.IsSingleReceiver(Model.RadioModel);
    string clarModeInit = (Model.RadioState.RxClarOn, Model.RadioState.TxClarOn) switch
    {
        (true, true)  => "rxtx",
        (true, false) => "rx",
        (false, true) => "tx",
        _             => "off"
    };

    // APF (Audio Peak Filter), CW only. The IC-7300 has no APF frequency shift
    // over CI-V — 16 32 selects a WIDTH, and OFF is one of the four positions —
    // so the control is a four-way selector, not a switch plus a slider.
    var apfSettings = new (string Value, string Label)[]
    {
        ("0", "Off"), ("1", "Wide"), ("2", "Mid"), ("3", "Nar")
    };

    // NOTE: The Yaesu IF-Width (SH-command) tables, roofing-filter options, and
    // Contour range vars were removed here during the IWC carve — the IC-7300 is
    // a direct-sampling SDR with no roofing filters and a different (CI-V) filter
    // model. A native IC-7300 IF-width control is a separate feature block.

    // Standard CTCSS tones
    // The 50 standard CTCSS tones, keyed by TENTHS of a Hz — the unit CI-V 1B
    // takes and the seam speaks, so nothing has to translate an index code.
    var ctcssTones = new (string Code, string Label)[]
    {
        ("670","67.0"), ("693","69.3"), ("719","71.9"), ("744","74.4"), ("770","77.0"),
        ("797","79.7"), ("825","82.5"), ("854","85.4"), ("885","88.5"), ("915","91.5"),
        ("948","94.8"), ("974","97.4"), ("1000","100.0"), ("1035","103.5"), ("1072","107.2"),
        ("1109","110.9"), ("1148","114.8"), ("1188","118.8"), ("1230","123.0"), ("1273","127.3"),
        ("1318","131.8"), ("1365","136.5"), ("1413","141.3"), ("1462","146.2"), ("1500","150.0"),
        ("1514","151.4"), ("1567","156.7"), ("1622","162.2"), ("1655","165.5"), ("1679","167.9"),
        ("1713","171.3"), ("1738","173.8"), ("1773","177.3"), ("1799","179.9"), ("1835","183.5"),
        ("1862","186.2"), ("1899","189.9"), ("1928","192.8"), ("1966","196.6"), ("1995","199.5"),
        ("2035","203.5"), ("2065","206.5"), ("2107","210.7"), ("2181","218.1"), ("2257","225.7"),
        ("2291","229.1"), ("2336","233.6"), ("2418","241.8"), ("2503","250.3"), ("2541","254.1")
    };

    // Renders one button of a DSP segmented button-group (replaces the old
    // <select> dropdowns). `action` is the JS to run on click (the radioControl
    // setter call). The button carries data-val so window.dspSetActive() can
    // re-highlight it when a matching SignalR state update arrives.
    string SegBtn(string group, string val, string label, string current, string action)
    {
        var active  = current == val ? " active" : "";
        var pressed = current == val ? "true" : "false";
        return $"<button type=\"button\" class=\"dsp-seg{active}\" data-val=\"{val}\" aria-pressed=\"{pressed}\" " +
               $"onclick=\"window.dspSetActive('{group}','{val}'); {action}\">{label}</button>";
    }
}

<!-- Cache-busted CSS reference.
     site.css used to be linked here too, with a hand-written ?v= that nobody
     remembered to bump. _Layout already links it with asp-append-version, so
     this was a second download of the same file on a URL that went stale
     silently. The layout's copy comes later in the document, so it was the one
     winning the cascade anyway. -->
<link rel="stylesheet" href="~/css/closer-to-raw-power.css?v=20260226n" />
<style>
    #saveMemBtnA, #saveMemBtnB { font-weight: 700 !important; font-size: 0.85rem !important; color: #212529 !important; }

    /* Pop-out (<dialog>) close ✕ button. The dialogs have a dark (#222)
       background, on which Bootstrap's btn-outline-secondary renders as
       near-black text on near-black — the ✕ effectively vanishes. Give it an
       explicit high-contrast red fill with a white glyph (matching the Twin PBT
       dialog's already-fixed close button) so it's always visible. */
    .iwc-dialog-close {
        background: #c0392b; color: #fff; border: 1px solid #e74c3c;
        font-weight: bold; font-size: 1rem; line-height: 1; padding: 2px 11px;
    }
    .iwc-dialog-close:hover, .iwc-dialog-close:focus {
        background: #e74c3c; color: #fff; border-color: #ff6b5a;
    }

    /* Voice command help popup (right-click a mic button). */
    #voiceHelpBody .vh-intro   { color: #bbb; font-size: 0.85rem; margin-bottom: 0.75rem; }
    #voiceHelpBody .vh-group   { margin-bottom: 0.85rem; }
    #voiceHelpBody .vh-group h6 { color: #4db8ff; font-size: 0.8rem; text-transform: uppercase;
                                  letter-spacing: 0.04em; margin: 0 0 0.35rem 0; }
    #voiceHelpBody .vh-item    { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem;
                                 align-items: baseline; padding: 0.15rem 0; }
    #voiceHelpBody .vh-what    { flex: 0 0 auto; min-width: 190px; }
    #voiceHelpBody .vh-ex      { color: #ffd47a; font-size: 0.85rem; }
    #voiceHelpBody .vh-ex code { color: #ffd47a; background: #333; border-radius: 3px;
                                 padding: 1px 5px; margin-right: 4px; white-space: nowrap; }

    /* Voice PTT button — three visually distinct states so the operator can
       always tell whether it's listening:
         1. Rest / hover (armed, NOT listening) -> amber outline. Bootstrap
            normally fills btn-outline-danger solid RED on hover, which was
            indistinguishable from the pressed/listening red; we override that
            to amber so "hovering" never looks like "listening".
         2. Pressed / listening -> solid red, pressed *in* (scaled down), with a
            bright pulsing ring and a breathing icon. Impossible to mistake.
         3. Release (pointer still on the button) -> snaps back to the amber
            hover look, so the red->amber change is proof the release registered.
       The pressed-in scale means the shape changes too, not just colour, which
       helps a partially-sighted operator. */

    /* Armed hover — amber, deliberately not red. :not(.voice-mic-listening)
       so it never fights the pressed state. */
    .voice-mic-btn.btn-outline-danger:hover:not(.voice-mic-listening) {
        background-color: #ffe69c;
        border-color: #ffc107;
        color: #664d03;
    }

    /* Pressed / listening — wins over every other state. */
    .voice-mic-btn.voice-mic-listening,
    .voice-mic-btn.voice-mic-listening:hover {
        background-color: #dc3545 !important;
        border-color: #b02a37 !important;
        color: #fff !important;
        transform: scale(0.94);
        animation: voiceMicPulse 1s ease-in-out infinite;
    }
    .voice-mic-btn.voice-mic-listening > i {
        animation: voiceMicIcon 1s ease-in-out infinite;
    }
    @@keyframes voiceMicPulse {
        0%   { box-shadow: 0 0 0 0    rgba(220, 53, 69, 0.75); }
        70%  { box-shadow: 0 0 0 18px rgba(220, 53, 69, 0);    }
        100% { box-shadow: 0 0 0 0    rgba(220, 53, 69, 0);    }
    }
    @@keyframes voiceMicIcon {
        0%, 100% { transform: scale(1);    opacity: 1;   }
        50%      { transform: scale(1.12); opacity: 0.85; }
    }

    /* Dual-receiver (FTdx101) active-band highlight: a subtle amber ring on
       the VFO panel the main tuning knob currently controls (MAIN or SUB).
       box-shadow so it never shifts layout; both receivers stay full-colour. */
    .vfo-active > .card.receiver-card {
        box-shadow: 0 0 0 2px #ffc107, 0 0 10px rgba(255, 193, 7, 0.5);
        transition: box-shadow 0.2s ease;
    }

    /* IWC single-receiver (IC-7300 MkII): the non-active VFO panel is NOT
       greyed or disabled. YWC greyed the inactive VFO's whole card-body
       because editing it over CAT would silently swap the radio's operating
       VFO (Jacek SP3L #34, ADR-0003). That doesn't apply to IWC: the pseudo-
       dual model treats VFO B as an independently-tunable *watch* VFO, and
       CivRadioController sets the non-active VFO's frequency/mode via CI-V
       25/26 (unselected-VFO) WITHOUT switching the operating VFO — so its
       band/mode/frequency controls are safe to drive directly. Both panels
       therefore stay full-colour and interactive (MM5AGM 2026-07-29). The
       live S-meter/history on the non-active panel is still hidden below
       (there is no second receiver, so a moving needle would mislead).
       The former .vfo-tx-editable split-mode carve-out is now moot — every
       control is interactive regardless of split — so those rules are gone. */

    /* Hide live receive indicators on the inactive VFO panel — on a real
       single-receiver radio there is no signal data for the inactive VFO,
       so showing a moving S-meter and a scrolling history would be
       misleading (suggests a signal is being received when nothing is).
       Display:none rather than visibility:hidden so the panel shrinks
       and the active panel's prominence is reinforced. */
    .vfo-inactive .analog-meter-container,
    .vfo-inactive .smeter-history-container {
        display: none !important;
    }
</style>

<!-- Message Box Modal (Windows-style) -->
<div class="modal fade" id="messageBoxModal" tabindex="-1" aria-labelledby="messageBoxTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content" style="border-radius: 4px; border: 2px solid #dc3545;">
            <div class="modal-header py-2" style="background: linear-gradient(to bottom, #dc3545, #c82333); border-bottom: 1px solid #bd2130;">
                <h6 class="modal-title text-white" id="messageBoxTitle" style="font-size: 0.9rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Warning
                </h6>
            </div>
            <div class="modal-body py-3" style="background: #fff;">
                <p id="messageBoxText" class="mb-0" style="font-size: 0.9rem; color: #000;"></p>
            </div>
            <div class="modal-footer py-2 justify-content-center" style="background: #f8f9fa; border-top: 1px solid #dee2e6;">
                <button type="button" class="btn btn-danger btn-sm px-4" data-bs-dismiss="modal" style="min-width: 80px;">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Start-up overlay. Covers the page from first paint until the UI has
     settled — see the stage gating in site.js. aria-live so the status text
     is announced as it changes rather than only being visible. -->
<div id="initOverlay" class="init-overlay" role="status" aria-live="polite">
    <div class="init-message">
        <div class="spinner-border text-primary" aria-hidden="true"></div>
        <div id="initStatusText">Initializing radio, please wait...</div>
        <!-- Escape hatch. The overlay is opaque and covers the whole page, so
             anything that stops it clearing would otherwise lock the operator
             out entirely. -->
        <button type="button" class="btn btn-sm btn-outline-light mt-3"
                onclick="dismissInitOverlay()">Continue anyway</button>
    </div>
</div>

<!-- Viewport too-narrow warning (shown once, dismissible) -->
<div id="viewportWarning" class="alert alert-warning alert-dismissible mb-1 py-1 px-3" role="alert" style="display:none; font-size:0.85rem;">
    <strong>Display settings may need attention.</strong>
    Your browser viewport appears narrow — meter gauges may wrap to a second row.
    Check <strong>Windows Display Settings</strong>: ensure resolution is set to native and scaling is correct for your monitor
    (recommended: <strong>150%</strong> for 4K, <strong>125%</strong> for 1440p, <strong>100%</strong> for 1080p).
    <button type="button" class="btn-close btn-sm py-2" onclick="dismissViewportWarning()" aria-label="Dismiss"></button>
</div>

<!-- Connection-problem banner. Driven by the ConnectionStatusText SignalR
     property (see site.js): shown when the CI-V link can't come up (e.g. the
     configured serial port isn't present), hidden the moment the radio
     connects. Not user-dismissible — it clears itself when the problem does.

     The Ports link is here because this banner is the one moment a user is
     definitely looking for the COM-port list, and /Ports is otherwise
     unreachable from the UI — nothing in the navbar points at it (issue #2,
     where the port list had to be asked for by email). Same tab is safe:
     site.js is in _Layout, so every page heartbeats and navigating away
     doesn't start RadioHub's 30-second shutdown countdown. -->
<div id="connectionProblemBanner" class="alert alert-warning mb-1 py-1 px-3" role="alert"
     aria-live="polite" style="display:none; font-size:0.85rem;">
    <i class="bi bi-plug-fill" aria-hidden="true"></i>
    <strong>Radio not connected.</strong>
    <span id="connectionProblemText"></span>
    <a asp-page="/Ports" class="alert-link ms-1">Check which COM ports this PC has</a>
</div>

<div class="row mb-1" style="padding-top: 2px; padding-bottom: 2px;">
        @if (Model.ShowApp1Button)
        {
            <div class="col-auto">
                <button id="wsjtxBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchWsjtx()" title="Launch @Model.App1Name" aria-label="Launch @Model.App1Name">
                    @Model.App1Name
                    <span id="wsjtxTxBadge" class="badge bg-danger ms-1" style="display:none;">TX</span>
                </button>
            </div>
        }
        @if (Model.ShowApp3Button)
        {
            <div class="col-auto">
                <button id="log4omBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchLog4om()" title="Launch @Model.App3Name" aria-label="Launch @Model.App3Name">
                    @Model.App3Name
                </button>
            </div>
        }
        @if (Model.ShowApp2Button)
        {
            <div class="col-auto">
                <button id="jtalertBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchJtalert()" title="Launch @Model.App2Name" aria-label="Launch @Model.App2Name">
                    @Model.App2Name
                </button>
            </div>
        }
        @if (Model.ShowApp4Button)
        {
            <div class="col-auto">
                <button id="gridtrackerBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchGridtracker()" title="Launch @Model.App4Name" aria-label="Launch @Model.App4Name">
                    @Model.App4Name
                </button>
            </div>
        }
        @if (Model.ShowApp5Button)
        {
            <div class="col-auto">
                <button id="fldigiBtn" class="btn btn-secondary btn-sm" style="padding-top: 1px; padding-bottom: 1px;"
                        onclick="launchFldigi()" title="Launch @Model.App5Name" aria-label="Launch @Model.App5Name">
                    @Model.App5Name
                </button>
            </div>
        }
        <div class="col-auto ms-auto d-flex gap-2 align-items-center">
            <span id="utcClock"
                  class="font-monospace fw-bold px-2"
                  style="font-size:0.95rem; color:#ffe066; background:#222; border:1px solid #444; border-radius:4px; padding-top: 1px; padding-bottom: 1px; cursor:help;"
                  title="UTC time from your PC system clock. Drifts if Windows can't reach time.windows.com. Click for details and how to verify."
                  onclick="document.getElementById('utcClockInfoDialog').show()"
                  aria-live="off"
                  aria-label="Current UTC time. Click for source and accuracy details.">--:--:--Z</span>
            <a href="https://paypal.me/mm5agm" target="_blank" rel="noopener noreferrer"
               class="btn btn-warning btn-sm" style="padding-top: 1px; padding-bottom: 1px;" title="Support this project via PayPal"
               aria-label="Support this project via PayPal — Buy Me a Coffee">
                <i class="bi bi-cup-hot-fill" aria-hidden="true"></i> Buy Me a Coffee
            </a>
            <button id="memBtn" class="btn btn-sm btn-outline-info fw-bold"
                    style="padding-top: 1px; padding-bottom: 1px; color: #000;" title="Open memories panel"
                    aria-label="Open memories panel">
                Mem
            </button>
            <button id="sMeterHistoryToggleBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Show/hide 30-second S-meter history strip (QSB, noise spikes, noise floor)"
                    aria-label="Show or hide the S-meter history strip"
                    aria-pressed="false">
                S-hist
            </button>
            <button id="vfoBToggleBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Show/Hide VFO-B"
                    aria-label="Show or hide VFO B panel">
                VFO-B
            </button>
            <button id="swapVfoBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Swap VFO A and VFO B frequencies"
                    aria-label="Swap VFO A and VFO B frequencies">
                A&#8596;B
            </button>
            <button id="copyBtoABtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Copy VFO B frequency &amp; mode to VFO A. VFO B is left unchanged. Useful for transmitting on VFO B's settings without enabling split."
                    aria-label="Copy VFO B to VFO A">
                B&rarr;A
            </button>
            <button id="copyAtoBBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;"
                    title="Copy VFO A frequency &amp; mode to VFO B. VFO A is left unchanged. Useful for seeding VFO B from VFO A before adjusting one of them."
                    aria-label="Copy VFO A to VFO B">
                A&rarr;B
            </button>
            <button id="splitBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Toggle Split: VFO A = receive, VFO B = transmit"
                    aria-label="Toggle split mode: VFO A receive, VFO B transmit">
                Split
            </button>
            <button id="quickSplitBtn" class="btn btn-sm btn-outline-secondary"
                    style="padding-top: 1px; padding-bottom: 1px;" title="Quick Split: enable split and set VFO B to VFO A + 5 kHz"
                    aria-label="Quick split: enable split and set VFO B to VFO A plus 5 kHz">
                +5k
            </button>
            <button id="connectBtn" class="btn btn-danger btn-sm"
                    onclick="toggleCatConnection()" style="padding-top: 1px; padding-bottom: 1px;" title="Connect or disconnect CAT serial port"
                    aria-label="CAT serial connection — currently disconnected">
                <i class="bi bi-plug" aria-hidden="true"></i> Disconnected
            </button>
            <button id="radioPowerBtn" class="btn btn-danger btn-sm"
                    onclick="toggleRadioPower()" style="padding-top: 1px; padding-bottom: 1px;" title="Radio Power On/Off"
                    aria-label="Radio power on or off">
                <i class="bi bi-power" aria-hidden="true"></i> POWER
            </button>
        </div>
    </div>

    <!-- (Status line moved inside each VFO panel — see #vfoAStatusLine / #vfoBStatusLine) -->

    <!-- Power and SWR Meters -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-body py-2">
                    <!-- Gauges row -->
                    <div class="d-flex justify-content-start align-items-start flex-wrap" style="margin-left: 0; gap: 0; margin-bottom: 0.2rem !important;">
                        <!-- S-Meter rolling history strip — leftmost so the live trace
                             reads left-to-right toward the S-meter needle. Hidden
                             until the toolbar's S-hist toggle is on. Sized to match
                             the meter cells alongside it. Moved from inside the VFO
                             panels in v2.3.9 (Jacek SP3L #34 / Colin's design call).
                             v2.4.0: restored as a VFO A / VFO B pair — dual-receiver
                             radios (FTdx101MP/D) have an independently calibrated
                             S-meter per receiver (SM0;/SM1;); single-receiver radios
                             only get the VFO A pair since there's no SUB receiver. -->
                        <div id="sMeterHistoryContainer"
                             class="text-center smeter-history-container"
                             style="display:none; position: relative; height: 135px; width: 260px; flex-shrink: 0; margin: 0; padding: 0;">
                            <canvas id="sMeterHistoryCanvas"
                                    role="img" aria-hidden="true"
                                    aria-label="S-meter 30-second history — VFO A"
                                    data-a11y-key="meters.smeterHistoryA"
                                    style="display:block; width:100%; height:100%; border-radius:3px;"></canvas>
                        </div>
                        <!-- S-Meter A (MAIN) — moved from per-VFO panels to the top
                             row in v2.3.9. Always live (unlike SWR/Power/etc which
                             are TX-only). -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="sMeterCanvas" role="img" aria-hidden="true" aria-label="S meter A" data-a11y-key="meters.smeterA"></canvas>
                            </div>
                        </div>
                        @if (!isSingleReceiver)
                        {
                            <!-- S-Meter B (SUB) — dual-receiver radios only. -->
                            <div id="sMeterHistoryContainerB"
                                 class="text-center smeter-history-container"
                                 style="display:none; position: relative; height: 135px; width: 260px; flex-shrink: 0; margin: 0; padding: 0;">
                                <canvas id="sMeterHistoryCanvasB"
                                        role="img" aria-hidden="true"
                                        aria-label="S-meter 30-second history — VFO B"
                                        data-a11y-key="meters.smeterHistoryB"
                                        style="display:block; width:100%; height:100%; border-radius:3px;"></canvas>
                            </div>
                            <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                                <div class="analog-meter-container">
                                    <canvas id="sMeterCanvasB" role="img" aria-hidden="true" aria-label="S meter B" data-a11y-key="meters.smeterB"></canvas>
                                </div>
                            </div>
                        }
                        <!-- SWR Meter -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="swrMeterCanvas" role="img" aria-hidden="true" aria-label="SWR meter" data-a11y-key="meters.swr"></canvas>
                            </div>
                        </div>
                        <!-- Power Meter -->
                        <div class="text-center power-meter-container" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="powerMeterCanvas" role="img" aria-hidden="true" aria-label="Power output meter" data-a11y-key="meters.power"></canvas>
                            </div>
                        </div>
                        <!-- Compression Meter -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="compressionMeterCanvas" role="img" aria-hidden="true" aria-label="Compression meter" data-a11y-key="meters.compression"></canvas>
                            </div>
                        </div>
                        <!-- ALC Meter -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="alcMeterCanvas" role="img" aria-hidden="true" aria-label="ALC meter" data-a11y-key="meters.alc"></canvas>
                            </div>
                        </div>
                        @* IC-7300 reports Id (drain current) and Vd (PA supply) over CI-V, but
                           has NO temperature meter over CI-V — the inherited PA-temp gauge is dropped. *@
                        <!-- IDD Meter — drain current (CI-V 15 16) -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="iddMeterCanvas" role="img" aria-hidden="true" aria-label="Drain current meter" data-a11y-key="meters.idd"></canvas>
                            </div>
                        </div>
                        <!-- VDD Meter — PA supply voltage (CI-V 15 15) -->
                        <div class="text-center" style="position: relative; height: 135px; min-width: 165px; margin: 0; padding: 0;">
                            <div class="analog-meter-container">
                                <canvas id="vddMeterCanvas" role="img" aria-hidden="true" aria-label="Amplifier supply voltage meter" data-a11y-key="meters.vdd"></canvas>
                            </div>
                        </div>
                    </div>
                    <!-- Power and MIC Gain on one row.
                         padding-left: 260px reserves the same width as the
                         S-meter history strip in the meter row above (whether
                         the strip is currently visible or not), so the Power
                         label always sits directly under the S-meter gauge
                         rather than under the (sometimes-hidden) history
                         strip. v2.3.9 layout change.
                         Padding on the flex container itself rather than a
                         spacer child -- a child element would have its own
                         flex slot and (with flex-wrap on) the spillover items
                         would wrap to a new line at x=0, defeating the point. -->
                    <div class="d-flex align-items-center gap-2 mb-2 closer-to-raw-power" style="margin-top: -18px !important; flex-wrap: wrap; padding-left: 280px;">
                        <label class="mb-0 text-nowrap">Power: <span id="powerValue" class="fw-bold">@Model.RadioState.Power W</span></label>
                        <input type="range" class="flex-shrink-0" id="powerSlider" data-a11y-key="controls.txPower"
                               aria-label="Transmit power"
                               title="Transmit power"
                               min="5" max="100" step="5"
                               value="@Model.RadioState.Power"
                               style="width: clamp(80px, 10vw, 150px); height: 18px;"
                               oninput="window.radioControl.updatePowerDisplay(window.txVfo === 1 ? 'B' : 'A', this.value)"
                               onchange="window.radioControl.setPower(window.txVfo === 1 ? 'B' : 'A', this.value)">
                        <label class="mb-0 text-nowrap ms-2"><span id="micGainLabel">MIC Gain</span>: <span id="micGainValue" class="fw-bold">@Model.MicGain</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="micGainSlider" data-a11y-key="controls.micGain"
                               aria-label="Microphone gain"
                               title="Microphone gain"
                               min="0" max="100" step="1"
                               value="@Model.MicGain"
                               style="width: clamp(80px, 10vw, 150px); height: 18px;"
                               oninput="document.getElementById('micGainValue').innerText = this.value;"
                               onchange="setMicGain(this.value);">
                        <button id="procBtn" data-a11y-key="controls.proc"
                                class="btn btn-sm ms-2 @(Model.ProcEnabled ? "btn-success" : "btn-outline-secondary")"
                                aria-label="Speech processor"
                                title="Speech processor on/off"
                                onclick="toggleProc()">@(Model.ProcEnabled ? "Proc On" : "Proc Off")</button>
                        <label class="mb-0 text-nowrap ms-2">PROC Level: <span id="procLevelValue" class="fw-bold">@Model.ProcLevel</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="procLevelSlider" data-a11y-key="controls.procLevel"
                               aria-label="Speech processor level"
                               title="Speech processor level"
                               min="0" max="100" step="1"
                               value="@Model.ProcLevel"
                               style="width: clamp(80px, 10vw, 150px); height: 18px;"
                               oninput="document.getElementById('procLevelValue').innerText = this.value;"
                               onchange="setProcLevel(this.value);">
                        <button id="atuBtn"
                                class="btn btn-sm ms-2 @(Model.AtuEnabled ? "btn-success" : "btn-outline-secondary")"
                                aria-label="Antenna tuner — short tap toggles on/off, long press starts auto-tune"
                                title="Tap to toggle ATU on/off; press and hold to start auto-tune"
                                style="touch-action: manipulation; user-select: none;">@(Model.AtuEnabled ? "ATU On" : "ATU Off")</button>
                        <button id="monitorOnBtn"
                                class="btn btn-sm ms-2 @(Model.MonitorOn ? "btn-warning" : "btn-outline-secondary")"
                                aria-label="TX monitor — currently @(Model.MonitorOn ? "on" : "off")"
                                title="Toggle TX monitor / sidetone on/off"
                                onclick="toggleMonitor()">Mon</button>
                        <label class="mb-0 text-nowrap ms-1"><span id="monLevelValue" class="fw-bold">@Model.MonitorLevelA</span></label>
                        <input type="range" class="flex-shrink-0"
                               id="monLevelSlider"
                               aria-label="TX monitor / sidetone level"
                               title="TX monitor / sidetone level"
                               min="0" max="100" step="1"
                               value="@Model.MonitorLevelA"
                               style="width: clamp(60px, 8vw, 110px); height: 18px;"
                               oninput="document.getElementById('monLevelValue').innerText = this.value;"
                               onchange="setMonitorLevel(this.value);">
                        <button id="voxBtn"
                                class="btn btn-sm ms-2 @(Model.VoxOn ? "btn-warning" : "btn-outline-secondary")"
                                aria-label="VOX controls"
                                title="Open VOX controls panel"
                                onclick="document.getElementById('voxDialog').show()">VOX</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="CW keyer controls"
                                title="Open CW keyer controls panel"
                                onclick="openCwDialog()">CW</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="FM repeater controls"
                                title="Open FM repeater controls panel"
                                onclick="document.getElementById('fmDialog').show()">FM Rep</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="DX watch — alerts for spotted callsigns"
                                title="Open DX watch list — get alerts when watched callsigns are spotted"
                                onclick="document.getElementById('dxWatchDialog').show(); window.refreshDxWatchList && window.refreshDxWatchList();">DX Watch</button>
                        <button class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="DX spots — list of cluster spots on current band"
                                title="Open DX spots list — see callsigns spotted on the current band"
                                onclick="window.dxSpotsPanel && window.dxSpotsPanel.toggle()">DX Spots</button>
                        <button id="voiceBtn"
                                class="btn btn-sm ms-1 btn-outline-secondary"
                                aria-label="Voice announcements settings"
                                title="Voice announcements for band, mode, TX state etc. — useful for partially sighted operators"
                                onclick="document.getElementById('voiceDialog').show();">Voice</button>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Spectrum Display — dual-VFO layout (v2.3.0+).
         Each panel has its own canvas. Mono A / Mono B / Multi toggle below
         hides/shows individual panels. Outer container hides itself when no
         SDR is configured for either VFO. -->
    <div id="spectrumContainer" class="row mt-3" style="display:none;">
        <div class="col-12">
            <!-- Scope on/off — always available while the spectrum is shown.
                 Turning it off stops the radio streaming waveform data (CI-V
                 27 10 / 27 11): the trace goes quiet. Also the operator's
                 control for testing whether the scope stream causes RX noise. -->
            <div class="d-flex justify-content-end align-items-center mb-2">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="scopeEnableSwitch" checked
                           title="Turn the radio's spectrum scope on or off">
                    <label class="form-check-label small" for="scopeEnableSwitch">Scope</label>
                </div>
            </div>
            <!-- Toggles row: VFO selector + layout (stacked vs side-by-side).
                 Both hidden when only one side is configured. -->
            <div id="spectrumModeToggle" class="d-flex justify-content-end align-items-center gap-2 mb-2" style="display:none;">
                <div class="btn-group btn-group-sm" role="group" aria-label="Spectrum panel layout">
                    <button type="button" class="btn btn-outline-secondary spectrum-layout-btn active" data-layout="stacked" title="Stack panels vertically">Stacked</button>
                    <button type="button" class="btn btn-outline-secondary spectrum-layout-btn" data-layout="side" title="Place panels side by side">Side&nbsp;by&nbsp;side</button>
                </div>
                <div class="btn-group btn-group-sm" role="group" aria-label="Spectrum visible VFO">
                    <button type="button" class="btn btn-outline-secondary spectrum-mode-btn" data-mode="A">VFO A</button>
                    <button type="button" class="btn btn-outline-secondary spectrum-mode-btn" data-mode="B">VFO B</button>
                    <button type="button" class="btn btn-outline-secondary spectrum-mode-btn active" data-mode="Multi">Both</button>
                </div>
            </div>

            <!-- Inner flex container — direction set by JS based on layout toggle.
                 flex-column (default) = stacked vertically.
                 flex-row             = side by side, each panel takes half the width. -->
            <div id="spectrumPanels" class="d-flex flex-column gap-2">
                <!-- VFO A spectrum panel.
                     flex:1 1 0 (not flex-fill = 1 1 auto) so two side-by-side
                     panels split evenly regardless of header content width.
                     Without this, a longer status-badge text on one side
                     pulls that card wider than the other. -->
                <div id="spectrumContainerA" class="card border-dark" style="flex: 1 1 0; min-width:0;">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-1">
                        <span class="small fw-bold"><i class="bi bi-broadcast-pin me-1" aria-hidden="true"></i>Spectrum — VFO A</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="VFO A spectrum span">
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="2500" data-vfo="A" data-a11y-key="spectrum.spanA5k" aria-label="VFO A span plus or minus 2.5 kHz" title="VFO A scope span ±2.5 kHz — narrowest, one QSO">±2.5k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="5000" data-vfo="A" data-a11y-key="spectrum.spanA10k" aria-label="VFO A span plus or minus 5 kHz" title="VFO A scope span ±5 kHz">±5k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="10000" data-vfo="A" data-a11y-key="spectrum.spanA20k" aria-label="VFO A span plus or minus 10 kHz" title="VFO A scope span ±10 kHz">±10k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="25000" data-vfo="A" data-a11y-key="spectrum.spanA50k" aria-label="VFO A span plus or minus 25 kHz" title="VFO A scope span ±25 kHz">±25k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="50000" data-vfo="A" data-a11y-key="spectrum.spanA100k" aria-label="VFO A span plus or minus 50 kHz" title="VFO A scope span ±50 kHz">±50k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="100000" data-vfo="A" data-a11y-key="spectrum.spanA200k" aria-label="VFO A span plus or minus 100 kHz" title="VFO A scope span ±100 kHz">±100k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="250000" data-vfo="A" data-a11y-key="spectrum.spanA500k" aria-label="VFO A span plus or minus 250 kHz" title="VFO A scope span ±250 kHz">±250k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="500000" data-vfo="A" data-a11y-key="spectrum.spanA1m" aria-label="VFO A span plus or minus 500 kHz" title="VFO A scope span ±500 kHz — widest">±500k</button>
                            </div>
                            <button type="button" class="btn btn-outline-light btn-sm spectrum-hold-btn" data-vfo="A" title="Freeze this spectrum at the current frame so you can study it. Click again to resume live streaming.">Hold</button>
                            <button type="button" class="btn btn-outline-light btn-sm spectrum-listen-btn" data-vfo="A" title="Listen to VFO A — route the radio's audio to this VFO. The other panel becomes the silent watch." style="display:none;"><i class="bi bi-volume-up" aria-hidden="true"></i> Listen</button>
                            <span class="badge bg-success small spectrum-audio-badge" data-vfo="A" title="You are listening to this VFO" style="display:none;"><i class="bi bi-volume-up-fill" aria-hidden="true"></i> Listening</span>
                            <span id="spectrumStatusBadgeA" class="badge bg-secondary small">—</span>
                        </div>
                    </div>
                    <div class="spectrum-dsp-bar d-flex align-items-center gap-2 px-2 py-1 small" data-vfo="A">
                        <label class="text-nowrap mb-0" title="Vertical scale height in dB. Smaller = taller peaks (more gain); larger = flatter. The noise floor is tracked automatically and pinned near the bottom, so this never moves it.">Range</label>
                        <input type="range" class="form-range spectrum-range-slider" data-vfo="A" min="5" max="140" step="1" value="@((int)Math.Round(Model.SdrSpectrumHighDbA - Model.SdrSpectrumLowDbA))" aria-label="VFO A spectrum range (dB scale height); noise floor tracked automatically" style="flex:0 0 70px; width:70px;">
                        <span class="text-monospace spectrum-range-label" data-vfo="A" style="min-width:4em; text-align:right;">@((int)Math.Round(Model.SdrSpectrumHighDbA - Model.SdrSpectrumLowDbA)) dB</span>
                        <label class="text-nowrap mb-0 ms-2" title="How fast the waterfall scrolls, from full speed down to 1/128. Does not affect the spectrum trace above it.">Speed</label>
                        <input type="range" class="form-range spectrum-speed-slider" data-vfo="A" data-server-speed="@Model.SdrWaterfallSpeedA" min="0" max="7" step="1" value="0" aria-label="VFO A waterfall scroll speed" style="flex:0 0 70px; width:70px;">
                        <span class="text-monospace spectrum-speed-label" data-vfo="A" style="min-width:3.5em; text-align:right;">Full</span>
                        <label class="text-nowrap mb-0 ms-2" title="Brighten the waterfall — lifts weak signals up the colour scale. Does not affect the spectrum trace above it.">Bright</label>
                        <input type="range" class="form-range spectrum-bright-slider" data-vfo="A" data-server-bright="@Model.SdrWaterfallBrightDbA" min="0" max="60" step="1" value="0" aria-label="VFO A waterfall brightness" style="flex:0 0 70px; width:70px;">
                        <span class="text-monospace spectrum-bright-label" data-vfo="A" style="min-width:3.5em; text-align:right;">Off</span>
                    </div>
                    <div class="card-body p-0">
                        <canvas id="spectrumCanvasA" role="img" aria-hidden="true" aria-label="RF spectrum display VFO A" style="display:block; width:100%;"></canvas>
                    </div>
                </div>

                <!-- VFO B spectrum panel — hidden by default; shown when SdrDeviceKeyB is configured.
                     Same flex:1 1 0 + min-width:0 as A so the two panels stay equal-width
                     in side-by-side layout regardless of badge text content. -->
                <div id="spectrumContainerB" class="card border-dark" style="display:none; flex: 1 1 0; min-width:0;">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-1">
                        <span class="small fw-bold"><i class="bi bi-broadcast-pin me-1" aria-hidden="true"></i>Spectrum — VFO B</span>
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group" aria-label="VFO B spectrum span">
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="2500" data-vfo="B" data-a11y-key="spectrum.spanB5k" aria-label="VFO B span plus or minus 2.5 kHz" title="VFO B scope span ±2.5 kHz — narrowest, one QSO">±2.5k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="5000" data-vfo="B" data-a11y-key="spectrum.spanB10k" aria-label="VFO B span plus or minus 5 kHz" title="VFO B scope span ±5 kHz">±5k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="10000" data-vfo="B" data-a11y-key="spectrum.spanB20k" aria-label="VFO B span plus or minus 10 kHz" title="VFO B scope span ±10 kHz">±10k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="25000" data-vfo="B" data-a11y-key="spectrum.spanB50k" aria-label="VFO B span plus or minus 25 kHz" title="VFO B scope span ±25 kHz">±25k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="50000" data-vfo="B" data-a11y-key="spectrum.spanB100k" aria-label="VFO B span plus or minus 50 kHz" title="VFO B scope span ±50 kHz">±50k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="100000" data-vfo="B" data-a11y-key="spectrum.spanB200k" aria-label="VFO B span plus or minus 100 kHz" title="VFO B scope span ±100 kHz">±100k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="250000" data-vfo="B" data-a11y-key="spectrum.spanB500k" aria-label="VFO B span plus or minus 250 kHz" title="VFO B scope span ±250 kHz">±250k</button>
                                <button type="button" class="btn btn-outline-light btn-sm span-btn" data-hz="500000" data-vfo="B" data-a11y-key="spectrum.spanB1m" aria-label="VFO B span plus or minus 500 kHz" title="VFO B scope span ±500 kHz — widest">±500k</button>
                            </div>
                            <button type="button" class="btn btn-outline-light btn-sm spectrum-hold-btn" data-vfo="B" title="Freeze this spectrum at the current frame so you can study it. Click again to resume live streaming.">Hold</button>
                            <button type="button" class="btn btn-outline-light btn-sm spectrum-listen-btn" data-vfo="B" title="Listen to VFO B — route the radio's audio to this VFO. The other panel becomes the silent watch." style="display:none;"><i class="bi bi-volume-up" aria-hidden="true"></i> Listen</button>
                            <span class="badge bg-success small spectrum-audio-badge" data-vfo="B" title="You are listening to this VFO" style="display:none;"><i class="bi bi-volume-up-fill" aria-hidden="true"></i> Listening</span>
                            <span id="spectrumStatusBadgeB" class="badge bg-secondary small">—</span>
                        </div>
                    </div>
                    <div class="spectrum-dsp-bar d-flex align-items-center gap-2 px-2 py-1 small" data-vfo="B">
                        <label class="text-nowrap mb-0" title="Vertical scale height in dB. Smaller = taller peaks (more gain); larger = flatter. The noise floor is tracked automatically and pinned near the bottom, so this never moves it.">Range</label>
                        <input type="range" class="form-range spectrum-range-slider" data-vfo="B" min="5" max="140" step="1" value="@((int)Math.Round(Model.SdrSpectrumHighDbB - Model.SdrSpectrumLowDbB))" aria-label="VFO B spectrum range (dB scale height); noise floor tracked automatically" style="flex:0 0 70px; width:70px;">
                        <span class="text-monospace spectrum-range-label" data-vfo="B" style="min-width:4em; text-align:right;">@((int)Math.Round(Model.SdrSpectrumHighDbB - Model.SdrSpectrumLowDbB)) dB</span>
                        <label class="text-nowrap mb-0 ms-2" title="How fast the waterfall scrolls, from full speed down to 1/128. Does not affect the spectrum trace above it.">Speed</label>
                        <input type="range" class="form-range spectrum-speed-slider" data-vfo="B" data-server-speed="@Model.SdrWaterfallSpeedB" min="0" max="7" step="1" value="0" aria-label="VFO B waterfall scroll speed" style="flex:0 0 70px; width:70px;">
                        <span class="text-monospace spectrum-speed-label" data-vfo="B" style="min-width:3.5em; text-align:right;">Full</span>
                        <label class="text-nowrap mb-0 ms-2" title="Brighten the waterfall — lifts weak signals up the colour scale. Does not affect the spectrum trace above it.">Bright</label>
                        <input type="range" class="form-range spectrum-bright-slider" data-vfo="B" data-server-bright="@Model.SdrWaterfallBrightDbB" min="0" max="60" step="1" value="0" aria-label="VFO B waterfall brightness" style="flex:0 0 70px; width:70px;">
                        <span class="text-monospace spectrum-bright-label" data-vfo="B" style="min-width:3.5em; text-align:right;">Off</span>
                    </div>
                    <div class="card-body p-0">
                        <canvas id="spectrumCanvasB" role="img" aria-hidden="true" aria-label="RF spectrum display VFO B" style="display:block; width:100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 flex-wrap" id="vfoRow" data-radio-model="@Model.RadioModel" data-single-receiver="@(isSingleReceiver ? "true" : "false")">
        <!-- VFO A Panel -->
        <div class="col-lg-6 col-12" id="vfoACol">
            <div class="card border-primary h-100 receiver-card">
                <div class="card-header bg-primary text-white py-1">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                        <h5 class="mb-0">
                            <span id="receiverAHeading">VFO A</span>
                        </h5>
                        <div class="d-flex align-items-center gap-1 flex-wrap">
                            <span id="splitTxBadgeA" class="badge bg-danger" style="display:none;" aria-live="polite">SPLIT TX</span>
                            <button id="txButtonA" class="btn btn-warning btn-sm" style="display:none;"
                                    onclick="toggleTx()" title="Toggle Transmit">
                                <i class="bi bi-broadcast" aria-hidden="true"></i> TX
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <!-- Receiver Controls Group: Save-to-Mem, Band buttons, Mode select.
                         The S-meter and its history strip moved to the top meter row
                         in v2.3.9 (Jacek SP3L #34, Colin's design call) -- the radio
                         has only one calibrated S-meter, so showing it once at the
                         top is honest. -->
                    <div class="receiver-controls-group d-flex flex-nowrap mb-0 gap-2 align-items-start">
                        <!-- Left: Save-to-Mem button (S-meter moved to top row) -->
                        <div class="flex-shrink-0">
                            <button id="saveMemBtnA" type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    style="padding:1px 4px;"
                                    onclick="saveVfoToMemory('A')"
                                    aria-label="Save VFO A to memories"
                                    title="Save VFO A frequency, mode and clarifier to app memories">
                                Save to Mem
                            </button>
                            <span id="saveMemStatusA" class="visually-hidden" role="status" aria-live="polite"></span>
                        </div>
                        <!-- Middle: Band buttons + Mode/Antenna below + filter scope -->
                        <div class="flex-grow-1 d-flex flex-column gap-1">
                            @await Html.PartialAsync("_BandButtonsPartial", Tuple.Create("unused", "A", Model.SelectedBandA))
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <label class="vfo-control-label" for="modeSelectA">Mode</label>
                                <select class="form-select form-select-sm vfo-mode-select" id="modeSelectA" data-a11y-key="vfo.a.mode"
                                        aria-label="VFO A mode"
                                        title="VFO A mode"
                                        onchange="setMode('A', this.value)">
                                    @foreach (var mode in allModes)
                                    {
                                        @if (Model.RadioState.ModeA == mode)
                                        {
                                            <option value="@mode" selected>@ModeLabel(mode)</option>
                                        }
                                        else
                                        {
                                            <option value="@mode">@ModeLabel(mode)</option>
                                        }
                                    }
                                </select>
                                @* No antenna selector. The IC-7300 family has one
                                   SO-239 ANT jack, so there is nothing to select
                                   between; the multi-antenna control was Yaesu-only. *@
                            </div>
                        </div>
                        <!-- Voice control mic button + step selector VFO A — large PTT target for accessibility, step select left of the button, both enlarged per Colin's testing feedback; shown only when voice control is enabled (voice-control.js) -->
                        <div class="flex-shrink-0" id="voiceMicContainerA" style="display:none;">
                            <div class="d-flex align-items-center gap-2">
                                <select id="voiceNudgeStepSelectA"
                                        class="form-select"
                                        style="width:auto; font-size:1.4rem; font-weight:600; padding:0.4rem 2.4rem 0.4rem 0.6rem;"
                                        title="Voice nudge step size — how far 'tune up'/'tune down' moves VFO A"
                                        aria-label="VFO A voice nudge step size">
                                    <option value="10">10 Hz</option>
                                    <option value="100">100 Hz</option>
                                    <option value="1000">1 kHz</option>
                                    <option value="10000">10 kHz</option>
                                    <option value="100000">100 kHz</option>
                                </select>
                                <button id="voiceMicBtnA" type="button"
                                        class="btn btn-outline-danger voice-mic-btn d-flex align-items-center justify-content-center"
                                        style="width:140px; height:120px; padding:0;"
