        async function setFmShift(v) { _fmSettings.shiftDir = v; }
        async function setFmOffset(v) { _fmSettings.offsetHz = v; }
        async function setCtcssMode(v) { _fmSettings.ctcssMode = v; }
        async function setCtcssTone(v) { _fmSettings.ctcssToneTenths = parseInt(v); }
        const _fmSettings = {
