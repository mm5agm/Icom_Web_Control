            } catch (e) { console.error('saveCwMessages error:', e); }
        }

        // --- TWIN PBT POPOUT ---
        // The IC-7300's Twin PBT (Digital Passband Tuning): two receiver-wide
        // shift values — PBT1 (inner) = CI-V 14 07, PBT2 (outer) = CI-V 14 08.
        // Each is 0–255 with 128 as centre (no shift). One dialog per VFO
        // button (either panel can open it); on the single-receiver IC-7300
        // both drive the same passband. The dialog id stays audioFilterDialog
        // {vfo} so drag-position persistence and the close-on-load list keep
        // working. Thin read/write proxy — the radio holds all state.
        window.audioFilter = (function () {
            const $ = (id) => document.getElementById(id);
            const PBT_CENTRE = 128;

            // 128 → "Centre"; otherwise a signed offset from centre.
            function fmtPbt(v) {
                if (v === PBT_CENTRE) return 'Centre';
                const off = v - PBT_CENTRE;
                return (off > 0 ? '+' : '') + off;
            }

            function makeInstance(vfo) {
                const dialogId = 'audioFilterDialog' + vfo;
                const dlg = () => $(dialogId);
                const el = (suffix) => $('audioFilter' + suffix + vfo);
                const inner = () => $('pbtInnerSlider' + vfo);
                const outer = () => $('pbtOuterSlider' + vfo);
                const innerLbl = () => $('pbtInnerLabel' + vfo);
                const outerLbl = () => $('pbtOuterLabel' + vfo);
                let _busy = false;

                async function open() {
                    const d = dlg();
                    if (d && typeof d.show === 'function' && !d.open) {
                        // On first open (no saved drag position), anchor the
                        // dialog just below the Twin PBT button that opened it.
                        const hasSaved = !!localStorage.getItem('dlgPos_' + dialogId);
                        if (!hasSaved) {
                            const btn = $('audioFilterBtn' + vfo);
                            if (btn) {
                                const r = btn.getBoundingClientRect();
                                d.style.left = Math.round(r.left) + 'px';
                                d.style.top  = Math.round(r.bottom + 6) + 'px';
                                d.style.transform = 'none';
                            }
                        }
                        d.show();
                    }
                    await refresh();
                }

                function setSlider(slider, label, value) {
                    if (!slider) return;
                    slider.value = value;
                    if (label) label.textContent = fmtPbt(value);
                }

                async function refresh() {
                    if (_busy) return;
                    _busy = true;
                    try {
                        const resp = await fetch('/api/cat/pbt');
                        if (!resp.ok) {
                            el('Status').textContent = 'Failed to read Twin PBT.';
                            return;
                        }
                        const data = await resp.json();
                        el('Status').textContent = '';
                        setSlider(inner(), innerLbl(),
                            typeof data.inner === 'number' ? data.inner : PBT_CENTRE);
                        setSlider(outer(), outerLbl(),
                            typeof data.outer === 'number' ? data.outer : PBT_CENTRE);
                    } catch (e) {
                        console.error(`twinPbt[${vfo}].refresh error:`, e);
                    } finally {
                        _busy = false;
                    }
                }

                async function writeEdge(edge, value) {
                    try {
                        const resp = await fetch('/api/cat/pbt/' + edge, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ value })
                        });
                        if (!resp.ok) el('Status').textContent = `Failed to set PBT ${edge}.`;
                    } catch (e) { console.error(`twinPbt[${vfo}].writeEdge error:`, e); }
                }

                function wireDom() {
                    const i = inner(), o = outer();
                    if (i) {
                        i.addEventListener('input',  (e) => innerLbl().textContent = fmtPbt(parseInt(e.target.value, 10)));
                        i.addEventListener('change', (e) => writeEdge('inner', parseInt(e.target.value, 10)));
                    }
                    if (o) {
                        o.addEventListener('input',  (e) => outerLbl().textContent = fmtPbt(parseInt(e.target.value, 10)));
                        o.addEventListener('change', (e) => writeEdge('outer', parseInt(e.target.value, 10)));
                    }
                    const clr = $('pbtClearBtn' + vfo);
                    if (clr) clr.addEventListener('click', async () => {
                        setSlider(inner(), innerLbl(), PBT_CENTRE);
                        setSlider(outer(), outerLbl(), PBT_CENTRE);
                        await writeEdge('inner', PBT_CENTRE);
                        await writeEdge('outer', PBT_CENTRE);
                    });
                }

                function onModeChanged(changedVfo) {
                    if (changedVfo !== vfo) return;
                    const d = dlg();
                    if (!d || !d.open) return;
                    refresh();
                }

                return { open, refresh, onModeChanged, wireDom };
            }

            const instances = { A: makeInstance('A'), B: makeInstance('B') };

            document.addEventListener('DOMContentLoaded', () => {
                instances.A.wireDom();
                instances.B.wireDom();
            });

            return {
                open: (vfo) => instances[(vfo === 'B') ? 'B' : 'A'].open(),
                onModeChanged: (vfo, mode) => {
                    instances.A.onModeChanged(vfo, mode);
                    instances.B.onModeChanged(vfo, mode);
                }
            };
        })();

        // --- RX TONE CONTROL (HPF/LPF audio filter) POPOUT ---
        // The IC-7300's per-mode RX Tone Control: a high-pass (low-cut) and a
        // low-pass (high-cut) audio edge = CI-V 1A 05 <item> HH LL. The item is
        // chosen server-side from the VFO's current mode; both edges are Hz with
        // 0 = "Through" (no cut). Unavailable in SSB-DATA — the server reports
        // that and we grey the controls. Thin read/write proxy; the radio holds
        // all state. One dialog per VFO button (either panel can open it).
        window.rxFilter = (function () {
            const $ = (id) => document.getElementById(id);
            // HPF: Through, then 100–2000 Hz. LPF: 500–2400 Hz, then Through.
            const HPF_HZ = [0]; for (let h = 100; h <= 2000; h += 100) HPF_HZ.push(h);
            const LPF_HZ = []; for (let h = 500; h <= 2400; h += 100) LPF_HZ.push(h); LPF_HZ.push(0);

            function fillSelect(sel, values) {
                if (!sel) return;
                sel.innerHTML = '';
                for (const hz of values) {
                    const o = document.createElement('option');
                    o.value = String(hz);
                    o.textContent = hz === 0 ? 'Through' : (hz + ' Hz');
                    sel.appendChild(o);
                }
            }

            function makeInstance(vfo) {
                const dialogId = 'rxFilterDialog' + vfo;
                const dlg = () => $(dialogId);
                const status = () => $('rxFilterStatus' + vfo);
                const controls = () => $('rxFilterControls' + vfo);
                const hpf = () => $('rxHpfSelect' + vfo);
                const lpf = () => $('rxLpfSelect' + vfo);
                let _busy = false;

                async function open() {
                    const d = dlg();
                    if (d && typeof d.show === 'function' && !d.open) {
                        const hasSaved = !!localStorage.getItem('dlgPos_' + dialogId);
                        if (!hasSaved) {
                            const btn = $('rxFilterBtn' + vfo);
                            if (btn) {
                                const r = btn.getBoundingClientRect();
                                d.style.left = Math.round(r.left) + 'px';
                                d.style.top  = Math.round(r.bottom + 6) + 'px';
                                d.style.transform = 'none';
                            }
                        }
                        d.show();
                    }
                    await refresh();
                }

                function setEnabled(on) {
                    const c = controls();
                    if (c) c.style.opacity = on ? '1' : '0.45';
                    if (hpf()) hpf().disabled = !on;
                    if (lpf()) lpf().disabled = !on;
                    const btn = $('rxFilterDefaultBtn' + vfo);
                    if (btn) btn.disabled = !on;
                }

                async function refresh() {
                    if (_busy) return;
                    _busy = true;
                    try {
                        const resp = await fetch('/api/cat/rxfilter/' + vfo.toLowerCase());
                        if (!resp.ok) {
                            status().textContent = 'Failed to read RX filter.';
                            setEnabled(false);
                            return;
                        }
                        const data = await resp.json();
                        if (!data.available) {
                            status().textContent = 'RX Tone Control not available in this mode (e.g. SSB-DATA).';
                            setEnabled(false);
                            return;
                        }
                        status().textContent = '';
                        setEnabled(true);
                        if (hpf()) hpf().value = String(data.hpfHz | 0);
                        if (lpf()) lpf().value = String(data.lpfHz | 0);
                    } catch (e) {
                        console.error(`rxFilter[${vfo}].refresh error:`, e);
                    } finally {
                        _busy = false;
                    }
                }

                async function writeBoth() {
                    const hpfHz = parseInt(hpf() ? hpf().value : '0', 10) || 0;
                    const lpfHz = parseInt(lpf() ? lpf().value : '0', 10) || 0;
                    try {
                        const resp = await fetch('/api/cat/rxfilter/' + vfo.toLowerCase(), {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ hpfHz, lpfHz })
                        });
                        if (!resp.ok) status().textContent = 'Failed to set RX filter.';
                    } catch (e) { console.error(`rxFilter[${vfo}].writeBoth error:`, e); }
                }

                function wireDom() {
                    fillSelect(hpf(), HPF_HZ);
                    fillSelect(lpf(), LPF_HZ);
                    if (hpf()) hpf().addEventListener('change', writeBoth);
                    if (lpf()) lpf().addEventListener('change', writeBoth);
                    const btn = $('rxFilterDefaultBtn' + vfo);
                    if (btn) btn.addEventListener('click', async () => {
                        if (hpf()) hpf().value = '0';   // HPF Through
                        if (lpf()) lpf().value = '0';   // LPF Through
                        await writeBoth();
                    });
                }

                function onModeChanged(changedVfo) {
                    if (changedVfo !== vfo) return;
                    const d = dlg();
                    if (!d || !d.open) return;
                    refresh();
                }

                return { open, refresh, onModeChanged, wireDom };
            }

            const instances = { A: makeInstance('A'), B: makeInstance('B') };

            document.addEventListener('DOMContentLoaded', () => {
                instances.A.wireDom();
                instances.B.wireDom();
            });

            return {
                open: (vfo) => instances[(vfo === 'B') ? 'B' : 'A'].open(),
                onModeChanged: (vfo, mode) => {
                    instances.A.onModeChanged(vfo, mode);
                    instances.B.onModeChanged(vfo, mode);
                }
            };
        })();

        // Expose functions called from HTML onclick/onchange attributes
        window.launchWsjtx  = launchWsjtx;
        window.launchJtalert = launchJtalert;
        window.launchLog4om  = launchLog4om;
        window.launchGridtracker = launchGridtracker;
        window.launchFldigi      = launchFldigi;
        window.setMicGain    = setMicGain;
        window.toggleProc    = toggleProc;
        window.setProcLevel  = setProcLevel;
        window.toggleAtu        = toggleAtu;
        window.startAtuTune     = startAtuTune;
        window.stopAtuTune      = stopAtuTune;
        window.updateAtuButton  = updateAtuButton;
        window.updateAtuTuningState = updateAtuTuningState;
        window.toggleMonitor    = toggleMonitor;
        window._updateMonitorBtn = _updateMonitorBtn;
        window.setMonitorLevel  = setMonitorLevel;
        window.setNbLevel      = setNbLevel;
        window.setNrLevel      = setNrLevel;
        window.setRfGain                  = setRfGain;
        window.setSquelch                 = setSquelch;
        window._updateSquelchVisibility   = _updateSquelchVisibility;
        // Apply squelch visibility for initial mode on page load
        _updateSquelchVisibility('A', '@Model.RadioState.ModeA');
        _updateSquelchVisibility('B', '@Model.RadioState.ModeB');
        window.toggleCatConnection = toggleCatConnection;
        window.toggleVox       = toggleVox;
        window.setVoxGain      = setVoxGain;
        window.setVoxDelay     = setVoxDelay;
        window.setAntiVoxGain  = setAntiVoxGain;
        window.setFmShift      = setFmShift;
        window.setFmOffset     = setFmOffset;
        window.setCtcssMode    = setCtcssMode;
        window.setCtcssTone    = setCtcssTone;
        window.saveFmRepeater  = saveFmRepeater;
        window.setCwPitch      = setCwPitch;
        window.setCwSpeed      = setCwSpeed;
        window.openCwDialog    = openCwDialog;
        window.stopCw          = stopCw;
        window.setCwBreakIn    = setCwBreakIn;
        window.setCwBreakInDelay = setCwBreakInDelay;
        window.sendCwMessage   = sendCwMessage;
        window.saveCwMessages  = saveCwMessages;
    </script>
    <script>
    (function () {
        const STORAGE_KEY = 'vfoBVisible';
        function getVisible() {
            const stored = localStorage.getItem(STORAGE_KEY);
            return stored !== null ? stored === 'true' : true;
        }

        function applyVisibility(visible) {
            const aCol  = document.getElementById('vfoACol');
            const bCol  = document.getElementById('vfoBCol');
            const btn   = document.getElementById('vfoBToggleBtn');
            if (bCol) bCol.style.display = visible ? '' : 'none';
            if (aCol) {
                if (visible) {
                    aCol.classList.remove('col-12');
                    aCol.classList.add('col-lg-6');
                } else {
                    aCol.classList.remove('col-lg-6');
                    aCol.classList.add('col-12');
                }
            }
            if (btn) {
                btn.textContent = visible ? 'Hide B' : 'Show B';
                btn.title = visible ? 'Hide VFO-B panel' : 'Show VFO-B panel';
            }
        }

        document.getElementById('vfoBToggleBtn')?.addEventListener('click', function () {
            const newVisible = !getVisible();
            localStorage.setItem(STORAGE_KEY, String(newVisible));
            applyVisibility(newVisible);
        });

        applyVisibility(getVisible());
    })();
    </script>
}