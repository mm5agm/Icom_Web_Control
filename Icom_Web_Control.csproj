<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RollForward>Minor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>

    <!-- Disable automatic content inclusion so we can manage wwwroot ourselves -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publish\**" />
    <Compile Remove="oldFiles\**" />
    <Compile Remove="oldFiles/Backup/**" />
    <Content Remove="oldFiles/Backup/**" />
    <EmbeddedResource Remove="oldFiles/Backup/**" />
    <None Remove="oldFiles/Backup/**" />
    <Compile Remove="BenchmarkSuite1\**" />
    <Content Remove="BenchmarkSuite1\**" />
    <EmbeddedResource Remove="BenchmarkSuite1\**" />
    <None Remove="BenchmarkSuite1\**" />
    <!-- core/ is the Radio_Web_Control_Core git subtree and is its own .csproj
         (ProjectReference below). The Web SDK globs **/*.cs, so without this
         removal every file in there is compiled TWICE — once into
         RadioWebControl.Core.dll and once straight into this assembly — which
         surfaces as duplicate-type errors rather than as anything that names
         the real cause. -->
    <Compile Remove="core\**" />
    <Content Remove="core\**" />
    <EmbeddedResource Remove="core\**" />
    <None Remove="core\**" />
  </ItemGroup>

  <!-- Radio-agnostic code shared with Yaesu Web Control. Pulled in as a git
       subtree, NOT a submodule, so a plain `git clone` of this repository still
       builds with no extra steps. See core/README.md for the subtree commands
       and docs/design/shared-core-plan.md for why any of this exists. -->
  <ItemGroup>
    <ProjectReference Include="core\RadioWebControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\RigState.cs" />
    <Compile Remove="Pages\Ports..cshtml.cs" />
    <Compile Remove="Pages\Shared\_BandButtonsPartial.cshtml.cs" />
    <Compile Remove="Services\CatPollingService.cs" />
    <Compile Remove="Services\IRigStateService.cs" />
    <Compile Remove="Services\RigStateService.cs" />
    <Compile Remove="Services\SerialPortCatClient.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="layout-old.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\FUNDING.yml" />
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.1" />
    <!-- System.Speech: Windows SAPI 5 grammar-based speech recognition.
         In-process voice control, replaces the parked Alexa work. See
         docs/VoiceControl/v1-plan.md. Windows-only — the surrounding
         project is already net10.0-windows so no portability change. -->
    <PackageReference Include="System.Speech" Version="10.0.1" />
    <!-- NAudio.WinMM: WaveIn (MME) device enumeration + capture only. Lets the
         user pick a specific microphone in Settings — System.Speech can bind
         only to the Windows *default* recording device or to a raw audio
         Stream, so we capture the chosen device ourselves at 16 kHz/16-bit/mono
         and feed SAPI via SetInputToAudioStream. See Services/Voice/
         MicrophoneCapture.cs. WinMM subset keeps WASAPI/MediaFoundation out. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <!-- Voice control grammar files shipped alongside the exe so
       VoiceControlService can load them at startup. Only .srgs is shipped;
       the README in this folder is documentation, not loaded by code. -->
  <ItemGroup>
    <Content Include="Grammars\*.srgs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <!-- Fresh IWC version line starting at 1.0.0; keep in step with Models/AppVersion.cs.
         AssemblyVersion/FileVersion must stay numeric; Version carries any label. -->
    <Version>1.0.6</Version>
    <FileVersion>1.0.6.0</FileVersion>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <AssemblyTitle>Icom Web Control</AssemblyTitle>
    <Product>Icom Web Control</Product>
    <Description>Browser-based CI-V controller for Icom HF transceivers</Description>
    <AssemblyName>Icom_Web_Control</AssemblyName>
    <RootNamespace>Icom_Web_Control</RootNamespace>
    <Company>MM5AGM</Company>
    <Copyright>© 2026 MM5AGM</Copyright>
  </PropertyGroup>
  <!-- Explicitly copy the entire wwwroot folder into the output directory -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy pictures folder (user manual screenshots served via PhysicalFileProvider) -->
  <ItemGroup>
    <Content Include="pictures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ship USER_MANUAL.md alongside the app so the in-app /UserManual page
       can render it. Read at request time from IWebHostEnvironment.ContentRootPath. -->
  <ItemGroup>
    <Content Include="USER_MANUAL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Explicitly include Razor Pages now that EnableDefaultContentItems is false -->
  <ItemGroup>
    <Content Include="Pages\**\*.cshtml" />
    <Content Include="Pages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>


